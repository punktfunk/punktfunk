# pacman scriptlet for the seat supervisor — mirrors build-seats-deb.sh's maintainer scripts.
# Nothing here enables the daemon: the console turns seats on.
_ensure_dirs() {
  systemd-tmpfiles --create /usr/lib/tmpfiles.d/punktfunk-seats.conf 2>/dev/null || true
}

post_install() {
  _ensure_dirs
}

post_upgrade() {
  _ensure_dirs
  # Restarts a running daemon, never enables one. Running seats stay up.
  systemctl try-restart punktfunk-seats.service punktfunk-door.service punktfunk-web-door.service 2>/dev/null || true
}

pre_remove() {
  # door-helper enables the door's units, so removal disables them.
  systemctl disable --now punktfunk-web-door.service punktfunk-door.service punktfunk-seats.service 2>/dev/null || true
}
