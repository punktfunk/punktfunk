#!/bin/bash
# punktfunk door helper (root): turns "Reachable without logging in" on or off for one user.
#
#   door-helper on  <user>   the box's host runs as the punktfunk system user from boot
#   door-helper off <user>   the user's own host serves the box again
#   door-helper ports        the recorded owner's ports, copied before each door start
#
# Started by punktfunk-door-on@<user>.service and punktfunk-door-off@<user>.service, which
# 49-punktfunk-door.rules lets members of `punktfunk-update` start. The instance name is data, not
# a command: the user must be an ordinary account in that group. `ports` is
# punktfunk-door.service's ExecStartPre.
#
# Both directions are idempotent, and a run that stopped halfway converges on the next. A first
# `on` that fails before the box's ports move puts the box back, and an `off` that can't hand the
# files home starts the door again, so neither leaves the box without a host or a console. The one
# record of "on, and for whom" is $STATE/owner, which only root writes; `punktfunk-seats
# check-owner` judges each switch by it (pf-seats `linux/door.rs`). The box's files move once: `on`
# copies the user's into /var/lib/punktfunk and marks that in $STATE/door-on, so a repeat never
# overwrites what the door has changed since; `off` copies the door's back to the user and clears
# both, and leaves them in $BOX for an owner whose account is gone.
#
# Every read and write that touches a user's home runs as that user, so a link the user plants
# there can't make root read or overwrite anything the user couldn't.
set -eu
export LC_ALL=C
# Root runs this: the system directories come first. NixOS keeps its tools in the unit's PATH.
export PATH="/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}"

BOX=/var/lib/punktfunk
# The seat supervisor's own directory, root's alone. `owner` there is the one account the door is
# on for, and the one the supervisor adopts as the box owner's row, so the door can't pick another.
# The door reads it to know whom to switch off for.
STATE=/var/lib/punktfunk-seats
RECORD="$STATE/owner"
MARK="$STATE/door-on"
# The owner's port lines for the door's two units, which also hand them to `ports`, as root.
PORTS="$STATE/host.env"
SEATS=/usr/libexec/punktfunk/punktfunk-seats
# The door user's primary group. Never `punktfunk`, which owns the usbip attach nodes and passes
# pf-dm-helper: the door opens no device.
DOOR_GROUP=punktfunk-door
# What the box's host keeps: identity, id, pairings, profiles, the console's password hash and
# what seals its sessions, so a signed-in console stays signed in across a switch. `profiles/`
# holds the avatars. The display policy and the hooks stay the owner's host's: the door passes
# their every read and write there, and the seat supervisor copies the policy.
FILES="native-cert.pem native-key.pem uniqueid punktfunk1-paired.json profiles.json web-password
web-session-key web-session-epoch"

die() {
    echo "door-helper: $*" >&2
    exit 1
}

as_door() { runuser -u punktfunk -- "$@"; }

# The door's account sits in its own group, checked at every door start and every `on`: an account
# with any other primary group moves, with the files that group owned, the door's directory, which
# the door changes itself, and the library copy, which is root's. Safe to repeat.
door_account_group() {
    getent passwd punktfunk >/dev/null || return 0
    getent group "$DOOR_GROUP" >/dev/null || groupadd --system "$DOOR_GROUP"
    [ "$(id -gn punktfunk)" = "$DOOR_GROUP" ] || usermod -g "$DOOR_GROUP" punktfunk
    # The door's own files only: a file another account left there, such as an updater's result,
    # stays as it is and never stops a switch.
    as_door find "$BOX" -xdev -user punktfunk ! -group "$DOOR_GROUP" -exec chgrp -h "$DOOR_GROUP" {} + ||
        echo "door-helper: some files in $BOX keep their group" >&2
    if [ -d "$STATE/library" ]; then
        find "$STATE/library" -xdev ! -group "$DOOR_GROUP" -exec chgrp -h "$DOOR_GROUP" {} +
    fi
}

verb=${1:-}
user=${2:-}
case $verb in
on | off) ;;
# Every door start. The account moves whoever the owner is, then the owner the last `on`
# recorded gives the ports; with none, the door has none to take.
ports)
    [ "$(id -u)" = 0 ] || die "run as root"
    door_account_group || echo "door-helper: couldn't move the door's account to $DOOR_GROUP" >&2
    [ ! -f "$RECORD" ] || chmod 0644 "$RECORD"
    user=$(cat "$RECORD" 2>/dev/null) || exit 0
    ;;
*) die "usage: door-helper on|off <user>, or door-helper ports" ;;
esac
[ "$(id -u)" = 0 ] || die "run as root"
# The instance name is data: one that starts with a dash would read as an option below.
case $user in '' | -*) die "'$user' is not a user name the seats accept" ;; esac

# `ports` runs inside the door's start, which `on` waits for while it holds this lock.
if [ "$verb" != ports ]; then
    exec 9>/run/punktfunk-door.lock
    flock 9
fi
recorded=$(cat "$RECORD" 2>/dev/null || true)
# Who may switch the door now, from the supervisor's binary, which reads the record and needs no
# running supervisor: `on|off <uid> <home>`, `takeover <gone owner> <uid> <home>`, or `gone`
# for a recorded owner whose account no longer exists. Any doubt refuses, the reason on stderr.
checked=$("$SEATS" check-owner "$([ "$verb" = on ] && echo on || echo off)" "$user") ||
    die "'$user' can't be switched"
gone=0 gone_owner='' uid='' OWN=''
case $checked in
gone) gone=1 ;;
takeover\ *) read -r _ gone_owner uid OWN <<<"$checked" ;;
*) read -r _ uid OWN <<<"$checked" ;;
esac
[ "$gone" = 1 ] || OWN="$OWN/.config/punktfunk"
[ -z "$gone_owner" ] || echo "door-helper: $gone_owner is gone, the door passes to $user" >&2

as_user() { runuser -u "$user" -- "$@"; }

# The user's systemd manager, when they have one. A user with no login and no linger has none, and
# then there is nothing running to change.
user_ctl() {
    [ "$gone" = 0 ] || return 1
    runuser -u "$user" -- env "XDG_RUNTIME_DIR=/run/user/$uid" systemctl --user "$@" 2>/dev/null
}

# $1 a file name under $BOX, written there from stdin as the door. The door owns $BOX, so root
# never writes a path in it: a link the door plants there leads only where the door can go.
to_door() {
    # shellcheck disable=SC2016 # the inner shell expands $1, not this one
    as_door sh -c 'umask 077; cat >"$1.tmp" && mv -f "$1.tmp" "$1"' sh "$BOX/$1"
}

# $1 a file name under $OWN, copied to $BOX for the door.
take() {
    as_user test -f "$OWN/$1" || return 0
    as_user cat -- "$OWN/$1" | to_door "$1"
}

# $1 a file name under $BOX, copied back to the user. Read as the door, written as the user, so
# neither side's links lead anywhere that user couldn't go.
give() {
    as_door test -f "$BOX/$1" || return 0
    # shellcheck disable=SC2016 # the inner shell expands $1, not this one
    as_door cat -- "$BOX/$1" | as_user sh -c 'umask 077; mkdir -p "$(dirname "$1")"; cat >"$1.tmp" && mv -f "$1.tmp" "$1"' sh "$OWN/$1"
}

# SteamOS keeps the console's password in web.env, beside its session secret and bind. There the
# door takes the password and secret lines, and hands the password line back into that file.
PASSWORD_LINE='^[[:space:]]*PUNKTFUNK_UI_PASSWORD(_HASH)?='
SECRET_LINE='^[[:space:]]*PUNKTFUNK_UI_SECRET='
steamos_password() { as_user test -f "$OWN/web.env" && ! as_user test -f "$OWN/web-password"; }

take_password() {
    steamos_password || return 0
    as_user cat -- "$OWN/web.env" | { grep -E "$PASSWORD_LINE|$SECRET_LINE" || true; } | to_door web-password
}

give_password() {
    if ! steamos_password; then
        give web-password
        return 0
    fi
    line=$(as_door cat -- "$BOX/web-password" 2>/dev/null | grep -E "$PASSWORD_LINE" | tail -n1)
    [ -n "$line" ] || return 0
    # shellcheck disable=SC2016 # the inner shell expands its own arguments
    as_user sh -c 'umask 077; { grep -vE "$3" "$1" || true; } >"$1.tmp" && printf "%s\n" "$2" >>"$1.tmp" && mv -f "$1.tmp" "$1"' \
        sh "$OWN/web.env" "$line" "$PASSWORD_LINE"
}

# The box's ports as the owner's host.env moves them, which the door binds in its place, and the
# console's bind, which the door's console keeps. SteamOS holds that bind in web.env, read last.
# Taken at each door start: the owner's files stay theirs, and the door never writes a port.
# `door-ports` keeps only the port lines, in $PORTS, where only root writes.
take_ports() {
    # Their files out of reach, as a home that isn't mounted yet: the last copy stays.
    as_user test -d "$OWN" || return 0
    # Either file may be absent: one missing must not end the group before the other is read.
    {
        as_user cat -- "$OWN/host.env" 2>/dev/null || true
        as_user cat -- "$OWN/web.env" 2>/dev/null || true
    } | "$SEATS" door-ports
}

safe_name() {
    case $1 in '' | . | .. | *[!A-Za-z0-9._-]*) return 1 ;; esac
}

# The avatars, by name: one safe_name refuses stays put. `|| continue`, because a loop whose last
# turn ends on a refusal returns it, and errexit then ends the whole switch.
take_avatars() {
    as_door mkdir -p -m 0700 "$BOX/profiles"
    for name in $(as_user ls -1 -- "$OWN/profiles" 2>/dev/null); do
        safe_name "$name" || continue
        take "profiles/$name"
    done
}

give_avatars() {
    for name in $(as_door ls -1 -- "$BOX/profiles" 2>/dev/null); do
        safe_name "$name" || continue
        give "profiles/$name"
    done
}

# The mark lives in $STATE, root's alone. One in $BOX, where the door can write, moves there for a
# recorded owner and is dropped otherwise, before anything reads the mark.
legacy_mark() {
    getent passwd punktfunk >/dev/null || return 0
    if [ -n "$recorded" ] && as_door test -f "$BOX/door-on"; then
        : >"$MARK"
    fi
    as_door rm -f "$BOX/door-on" || true
}

# A first `on` that fails puts the box back as it was: no record, mark or owner row, and the
# supervisor off unless it was on already. The user's own files were only copied.
undo_on() {
    echo "door-helper: couldn't switch the door on, putting the box back" >&2
    if systemctl is-active --quiet punktfunk-seats.service; then
        "$SEATS" release-owner >/dev/null || true
    fi
    rm -f "$MARK" "$RECORD" "/run/punktfunk/seats/$user.env"
    [ "$seats_were_up" = 1 ] || unwire punktfunk-seats.service || true
}

door_on() {
    fresh=0
    [ -n "$recorded" ] || fresh=1
    seats_were_up=0
    if systemctl is-active --quiet punktfunk-seats.service; then seats_were_up=1; fi
    getent group "$DOOR_GROUP" >/dev/null || groupadd --system "$DOOR_GROUP"
    if ! getent passwd punktfunk >/dev/null; then
        shell=$(command -v nologin || echo /usr/sbin/nologin)
        useradd --system --no-user-group --gid "$DOOR_GROUP" --home-dir "$BOX" --shell "$shell" punktfunk
    fi
    install -d -m 0711 -o punktfunk -g "$DOOR_GROUP" "$BOX"
    door_account_group
    # The shared games folder's group; the owner's Steam moves games into it at their next login.
    getent group punktfunk-games >/dev/null || groupadd --system punktfunk-games
    usermod -aG punktfunk-games "$user"
    install -d -m 0711 -o root -g root "$STATE"
    legacy_mark
    # A gone owner's files stay in $BOX; this member's replace them where they have the same file.
    [ -z "$gone_owner" ] || rm -f "$MARK"
    [ "$fresh" = 0 ] || trap undo_on EXIT
    printf '%s\n' "$user" >"$RECORD.tmp"
    chmod 0644 "$RECORD.tmp"
    mv -f "$RECORD.tmp" "$RECORD"
    if [ ! -e "$MARK" ]; then
        for f in $FILES; do take "$f"; done
        # The door's own rows start as the owner set them. Never handed back: the owner's host
        # keeps its file, and the door sends its rows there before it switches off.
        take host-settings.json
        take_password
        take_avatars
        : >"$MARK"
    fi
    wire punktfunk-seats.service
    # Ready once its socket is bound (Type=notify).
    systemctl start punktfunk-seats.service
    "$SEATS" adopt-owner "$user" >/dev/null
    wire punktfunk-door.service punktfunk-web-door.service
    trap - EXIT
    # The box's ports are the door's from here, so the user's console and host leave them first.
    # The host restarts on the owner row's contract: its own ports, and the box's identity.
    user_ctl stop punktfunk-web.service || true
    user_ctl try-restart punktfunk-host.service || true
    systemctl restart punktfunk-door.service punktfunk-web-door.service
    echo "door on for $user"
}

# Units that start at boot, or stop and no longer do. NixOS wires them in its configuration and its
# unit directory can't be written, so a refused change is fine for a unit already in that state.
wire() {
    for unit in "$@"; do
        systemctl enable "$unit" || systemctl is-enabled --quiet "$unit" || die "can't enable $unit"
    done
}

unwire() { systemctl disable --now "$@" || systemctl stop "$@"; }

# The door stopped to hand its files home and they didn't arrive: it comes back as it was.
restore_door() {
    echo "door-helper: couldn't hand the door's files back, starting the door again" >&2
    systemctl start --no-block punktfunk-door.service punktfunk-web-door.service || true
}

door_off() {
    trap restore_door EXIT
    systemctl stop punktfunk-web-door.service punktfunk-door.service || true
    legacy_mark
    if [ "$gone" = 1 ]; then
        echo "door-helper: $user is gone, the door's files stay in $BOX" >&2
    elif [ -e "$MARK" ]; then
        for f in $FILES; do [ "$f" = web-password ] || give "$f"; done
        give_password
        give_avatars
    fi
    trap - EXIT
    # The files are home. A repeat must not copy the door's stale ones over the user's.
    rm -f "$MARK"
    # From here only forward: each step is tried, and the record stays until all of them held.
    problems=0
    if systemctl is-active --quiet punktfunk-seats.service; then
        # Seats the door placed stop with it; their accounts and profiles stay for the next time.
        "$SEATS" stop-all >/dev/null || problems=1
        "$SEATS" release-owner >/dev/null || problems=1
    fi
    # A stopped supervisor leaves the owner's contract behind, and their host and console read it.
    rm -f "/run/punktfunk/seats/$user.env"
    unwire punktfunk-web-door.service punktfunk-door.service punktfunk-seats.service || problems=1
    user_ctl try-restart punktfunk-host.service || true
    # Their console comes back only if it was theirs to begin with.
    if user_ctl is-enabled --quiet punktfunk-web.service; then
        user_ctl start punktfunk-web.service || true
    fi
    [ "$problems" = 0 ] || die "cleanup after switching off $user failed, switch it off again"
    rm -f "$RECORD"
    echo "door off for $user"
}

case $verb in
on) door_on ;;
off) door_off ;;
ports)
    legacy_mark
    # The copy the door kept in $BOX before $PORTS: filtered the same way, once, then removed.
    if [ ! -e "$PORTS" ]; then
        as_door cat -- "$BOX/host.env" 2>/dev/null | "$SEATS" door-ports
        as_door rm -f "$BOX/host.env" || true
    fi
    [ "$gone" = 1 ] || take_ports
    ;;
esac
