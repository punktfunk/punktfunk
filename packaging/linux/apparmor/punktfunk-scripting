# AppArmor policy for the plugin runner (punktfunk-scripting.service).
#
# Where AppArmor keeps unprivileged user namespaces from unconfined processes
# (kernel.apparmor_restrict_unprivileged_userns=1, Ubuntu's default), systemd cannot build the
# unit's mount namespace. The punktfunk-scripting-apparmor user generator then starts the runner
# through apparmor-confined, the path this profile attaches to. Nothing else runs that path, so
# elsewhere the profile is loaded and unused.
#
# Attached to a path, never set by the unit: a profile the user manager sets stacks onto
# `unconfined`, and in that half unshare gets no capability and pasta cannot start.
#
# Site additions go in local/punktfunk-scripting, as a unit's go in a drop-in.

abi <abi/4.0>,

include <tunables/global>

# A made seat's home sits under the seats tree, outside @{HOME}.
@{PF_HOMES}=@{HOME} /var/lib/punktfunk-seats/seats/*/home/

profile punktfunk-scripting /usr/lib/punktfunk-scripting/apparmor-confined flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>
  include <abstractions/nameservice>
  include <abstractions/private-files-strict>

  # unshare, bwrap and pasta build each plugin sandbox from these. The capabilities hold only
  # inside the user namespaces unshare and bwrap make.
  userns,
  capability sys_admin,
  capability setpcap,
  capability net_admin,
  capability sys_ptrace,
  capability dac_override,
  capability sys_resource,
  mount,
  umount,
  pivot_root,
  # --disable-userns, inside the sandbox's own user namespace.
  @{PROC}/sys/user/max_user_namespaces w,
  # pasta connects a network plugin's namespace through a tap device.
  /dev/net/tun rw,
  # A bind must not carry the config dir to a path the file rules below do not cover.
  deny mount /**/.config/punktfunk{,/,/*} -> /**,
  deny mount /**/.config{,/} -> /**,
  deny mount /{,**/}home/{,*,*/} -> /**,
  deny mount /{,oldroot/} -> /**,

  network,
  unix,
  dbus,
  signal (receive) peer=unconfined,
  # This tree only. Attached, every child inherits this profile (`ix` below) and its label. Set
  # by a unit instead, it stacks onto unconfined, and bwrap's own profile stacks onto it.
  signal peer="{,bwrap//&}punktfunk-scripting{,//&unconfined,//&unpriv_bwrap}",
  ptrace (read, trace) peer="{,bwrap//&}punktfunk-scripting{,//&unconfined,//&unpriv_bwrap}",

  # The user's own files, as the unit's binds and write grants reach them.
  / r,
  /** rmix,
  owner /** wlk,

  # The host's config dir: only what the unit binds.
  deny @{PF_HOMES}/.config/punktfunk/** mrwlkx,
  priority=1 owner @{PF_HOMES}/.config/punktfunk/ r,
  priority=1 owner @{PF_HOMES}/.config/punktfunk/{plugin-token,mgmt-endpoint,native-cert.pem,cert.pem} r,
  priority=1 owner @{PF_HOMES}/.config/punktfunk/{scripts,ingest,plugin-run}/{,**} r,
  priority=1 owner @{PF_HOMES}/.config/punktfunk/{plugins,plugin-state}/{,**} mrwlkix,

  # Code written here runs outside this profile at the next login.
  deny @{PF_HOMES}/.config/systemd/** wl,
  deny @{PF_HOMES}/.local/share/systemd/** wl,
  deny @{PF_HOMES}/.config/environment.d/** wl,

  include if exists <local/punktfunk-scripting>
}

# The runner of a seat on a person's own account (punktfunk-scripting-seat@.service): the profile
# above over the seat's config directory, with none of the person's own.
profile punktfunk-scripting-seat /usr/lib/punktfunk-scripting/apparmor-confined-seat flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>
  include <abstractions/nameservice>
  include <abstractions/private-files-strict>

  userns,
  capability sys_admin,
  capability setpcap,
  capability net_admin,
  capability sys_ptrace,
  capability dac_override,
  capability sys_resource,
  mount,
  umount,
  pivot_root,
  @{PROC}/sys/user/max_user_namespaces w,
  /dev/net/tun rw,
  deny mount /**/.config/punktfunk{,/,/*} -> /**,
  deny mount /**/.config{,/} -> /**,
  deny mount /{,**/}home/{,*,*/} -> /**,
  deny mount /{,oldroot/} -> /**,
  deny mount /var/lib/punktfunk-seats/{,seats/,seats/*/,seats/*/config/,seats/*/config/*} -> /**,

  network,
  unix,
  dbus,
  signal (receive) peer=unconfined,
  signal peer="{,bwrap//&}punktfunk-scripting-seat{,//&unconfined,//&unpriv_bwrap}",
  ptrace (read, trace) peer="{,bwrap//&}punktfunk-scripting-seat{,//&unconfined,//&unpriv_bwrap}",

  / r,
  /** rmix,
  owner /** wlk,

  # The person's own desk config, and the seat's trust copy: none of either.
  deny @{HOME}/.config/punktfunk/** mrwlkx,
  deny /var/lib/punktfunk-seats/trust/** mrwlkx,
  # The seat's config dir: only what the unit binds.
  deny /var/lib/punktfunk-seats/seats/*/config/** mrwlkx,
  priority=1 owner /var/lib/punktfunk-seats/seats/*/config/ r,
  priority=1 owner /var/lib/punktfunk-seats/seats/*/config/{plugin-token,mgmt-endpoint,native-cert.pem,cert.pem} r,
  priority=1 owner /var/lib/punktfunk-seats/seats/*/config/{ingest,plugin-run}/{,**} r,
  priority=1 owner /var/lib/punktfunk-seats/seats/*/config/{plugins,plugin-state}/{,**} mrwlkix,

  deny @{HOME}/.config/systemd/** wl,
  deny @{HOME}/.local/share/systemd/** wl,
  deny @{HOME}/.config/environment.d/** wl,

  include if exists <local/punktfunk-scripting-seat>
}
