[Desktop Entry]
Type=Application
Name=Punktfunk Host
GenericName=Streaming host
GenericName[de]=Streaming-Host
GenericName[es]=Host de transmisión
GenericName[fr]=Hôte de streaming
Comment=Start the streaming host, its web console and plugin runner, and show their status in the tray
Comment[de]=Streaming-Host, Web-Konsole und Plugin-Runner starten und ihren Status im Tray anzeigen
Comment[es]=Inicia el host de transmisión, su consola web y el ejecutor de plugins, y muestra su estado en la bandeja del sistema
Comment[fr]=Démarre l’hôte de streaming, sa console web et son exécuteur de plugins, et affiche leur état dans la zone de notification
# The Windows "Punktfunk Host" Start-menu link runs the same command.
Exec=/usr/bin/punktfunk-tray --start-host
Icon=punktfunk-tray
Terminal=false
StartupNotify=false
Categories=Network;RemoteAccess;
Keywords=streaming;host;server;tray;status;
Keywords[de]=Streaming;Host;Server;Tray;Infobereich;Status;
Keywords[es]=transmisión;streaming;host;servidor;bandeja;estado;
Keywords[fr]=streaming;hôte;serveur;zone de notification;état;
Actions=status;

[Desktop Action status]
Name=Show status only
Name[de]=Nur Status anzeigen
Name[es]=Mostrar solo el estado
Name[fr]=Afficher l’état uniquement
Exec=/usr/bin/punktfunk-tray
