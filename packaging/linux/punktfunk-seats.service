# punktfunk seat supervisor: runs a user, a session and a host per seat for the box's host.
#
# Root, because it creates users and starts units. Seats are units of their own, so restarting or
# stopping this service leaves them running; the next start reads their state back from systemd.
# The socket answers root and the punktfunk user only.
#
# No ProtectSystem=: useradd writes /etc/passwd, /etc/shadow and /etc/group.
[Unit]
Description=punktfunk seat supervisor
After=local-fs.target systemd-logind.service
Wants=systemd-logind.service
# The owner's host reads its contract from /run/punktfunk/seats, which this writes at start. A
# user manager starts after systemd-user-sessions, so ready here is before any user host starts
# on the box's own ports.
Before=systemd-user-sessions.service

[Service]
# Ready once the owner's files are written and the socket is bound.
Type=notify
TimeoutStartSec=30
# The box host's config directory. The ledger lands in seats/ below it.
Environment=PUNKTFUNK_CONFIG_DIR=/var/lib/punktfunk
ExecStart=/usr/libexec/punktfunk/punktfunk-seats serve --socket /run/punktfunk/seats.sock
Restart=on-failure
RestartSec=2
# What useradd, systemctl, setfacl and chown need, and nothing more.
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_FSETID CAP_KILL CAP_SETUID CAP_SETGID CAP_AUDIT_WRITE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
