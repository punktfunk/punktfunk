# punktfunk seat supervisor: runs a user, a session and a host per seat for the box's host.
#
# Root, because it creates users and starts units. Seats are units of their own, so restarting or
# stopping this service leaves them running; the next start reads their state back from systemd.
# The socket answers root and the punktfunk user only.
#
# No ProtectSystem=: useradd writes /etc/passwd, /etc/shadow and /etc/group.
[Unit]
Description=punktfunk seat supervisor
After=local-fs.target systemd-logind.service
Wants=systemd-logind.service
# The owner's host reads its contract from /run/punktfunk/seats, which this writes at start. A
# login waits for systemd-user-sessions; a lingering user's manager waits for this through
# punktfunk-seats-user.conf.
Before=systemd-user-sessions.service

[Service]
# Ready once the owner's files and the box's library copy are written and the socket is bound.
# The library copy can take a while: room for that.
Type=notify
TimeoutStartSec=90
# The door's directory, whose files the trust copies follow. The supervisor's own state, the
# ledger included, is /var/lib/punktfunk-seats.
Environment=PUNKTFUNK_CONFIG_DIR=/var/lib/punktfunk
ExecStart=/usr/libexec/punktfunk/punktfunk-seats serve --socket /run/punktfunk/seats.sock
# A seat's blocking uinput reads sit in this process until answered; the stop signal would
# strand them in the kernel. This answers them first.
ExecStop=-/usr/libexec/punktfunk/punktfunk-seats drain
# No seat attaches while the supervisor is down, so its stop opens the vhci gate once no seat
# holds a port, and gives the box's hidraw nodes back their distro modes.
ExecStopPost=-/usr/libexec/punktfunk/punktfunk-seats ungate
Restart=on-failure
RestartSec=2
# A relayed pad's fds wait here across a restart, so an update keeps a seat's controllers.
FileDescriptorStoreMax=256
# What useradd, systemctl, setfacl and chown need, and nothing more.
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_FSETID CAP_KILL CAP_SETUID CAP_SETGID CAP_AUDIT_WRITE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
# The pad broker attaches a seat's USB devices and gates the vhci hubs, and has udev re-apply
# its rules to the nodes of each uinput device it records for the fence.
ReadWritePaths=-/sys/devices/platform/vhci_hcd.0 -/sys/devices/platform/vhci_hcd -/sys/devices/virtual/input
# Each seat's /dev/uinput is a CUSE device made here: no PrivateDevices= or DeviceAllow=. The
# first open of /dev/cuse still autoloads cuse; the kernel runs that modprobe, not this unit.
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
