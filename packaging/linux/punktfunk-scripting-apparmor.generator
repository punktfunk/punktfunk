#!/bin/sh
# systemd user generator: confine the plugin runners with AppArmor where AppArmor keeps unprivileged
# user namespaces from unconfined processes. There systemd skips a unit's mount namespace in
# silence and its bounding-set drop fails, so this drop-in trades every directive that needs a
# namespace for the profile of the unit's name: punktfunk-scripting, and punktfunk-scripting-seat
# for a seat on a person's own account. A box without the profile fails the unit closed.
# Elsewhere it writes nothing and each unit keeps its namespace sandbox.
[ "$(cat /proc/sys/kernel/apparmor_restrict_unprivileged_userns 2>/dev/null)" = 1 ] || exit 0
for unit in punktfunk-scripting punktfunk-scripting-seat@; do
  dir="$1/$unit.service.d"
  mkdir -p "$dir" || exit 0
  # `zz-` sorts after `systemctl --user edit`'s override.conf and the host's roots drop-in.
  cat > "$dir/zz-apparmor.conf" <<EOF
[Service]
AppArmorProfile=${unit%@}
ProtectSystem=no
ProtectHome=no
ProtectControlGroups=no
TemporaryFileSystem=
InaccessiblePaths=
BindPaths=
BindReadOnlyPaths=
ReadWritePaths=
CapabilityBoundingSet=~
EOF
done
exit 0
