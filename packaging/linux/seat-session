#!/usr/bin/env bash
# punktfunk seat runner: a headless desktop, then a stock `punktfunk-host serve` on it.
#
# punktfunk-seat@.service runs this as the seat's user inside a logind session. The seat contract
# (PUNKTFUNK_SEAT_*, the ports, the trust dir, PUNKTFUNK_MGMT_TOKEN) arrives in the environment.
# The desktop mirrors scripts/headless/run-headless-kde.sh; without a kwin_wayland that starts the
# host starts gamescope itself.
#
# Game Mode is the host's: it answers steamos-manager's session switch on the seat's bus and moves
# its streams between this desktop and a gamescope of its own, so the desktop keeps running.
# steamos-session-select and steamos-desktop-return on PATH call the host the same way.
#
# pam_systemd moves this process and its children into the session's scope, so stopping the unit
# signals only this script. It records the session id for seat-reap and kills its own children on
# SIGTERM; seat-reap kills whatever is left.
#
# A row on a person's own account runs as that person beside whatever they have on the monitor:
# the owner's in a `background` session, another person's in the unit's `user` class, which a
# shutdown at the machine counts as another user's session. It leaves their user manager, their
# config and their PipeWire alone: the desktop and the host sit on a bus of their own, and the
# person's own punktfunk-host and punktfunk-kde-session stand down while this runs (their units
# have ConditionPathExists= on the runtime directory). Two variables say so. PUNKTFUNK_SEAT_OWNER=1 is the box owner's row, which
# also takes the owner's host.env and stops the owner's own user units. PUNKTFUNK_SEAT_OWN_ACCOUNT=1
# is another person's row: a contract seat's host on their account, with no owner's settings and
# none of their processes stopped. The seat contract wins over any file.
set -u

HOST="${PUNKTFUNK_HOST_BIN:-/usr/bin/punktfunk-host}"
SIZE="${PUNKTFUNK_SEAT_SIZE:-1920x1080}"
W="${SIZE%x*}"
H="${SIZE#*x}"

# Only the host gets the management token; kwin, plasmashell and games never see it.
TOKEN="${PUNKTFUNK_MGMT_TOKEN:-}"
unset PUNKTFUNK_MGMT_TOKEN

# Exports each KEY=value of $1 as systemd's EnvironmentFile= reads the lines host.env and the NixOS
# settings hold, so the owner's row gets what their user unit gets. `#` and `;` lines are comments;
# a value loses the whitespace around it and its quotes; in double quotes a backslash escapes
# " \ ` $, unquoted it escapes any character. Nothing in the file runs.
read_env_file() {
    local line key value esc out i
    while IFS= read -r line || [[ -n $line ]]; do
        line=${line#"${line%%[![:space:]]*}"}
        [[ $line == *=* && $line != [#\;]* ]] || continue
        key=${line%%=*}
        key=${key%"${key##*[![:space:]]}"}
        [[ $key =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
        value=${line#*=}
        value=${value#"${value%%[![:space:]]*}"}
        value=${value%"${value##*[![:space:]]}"}
        esc='?'
        if [[ $value =~ ^\'(.*)\'$ ]]; then
            value=${BASH_REMATCH[1]} esc=
        elif [[ $value =~ ^\"(.*)\"$ ]]; then
            value=${BASH_REMATCH[1]} esc='[\"\\`$]'
        fi
        out=
        for ((i = 0; i < ${#value}; i++)); do
            # shellcheck disable=SC2053 # $esc is the pattern of characters a backslash escapes
            [[ -n $esc && ${value:i:1} == \\ && ${value:i+1:1} == $esc ]] && ((i += 1))
            out+=${value:i:1}
        done
        export "$key=$out"
    done <"$1"
}

# `seat-session --self-test`: read_env_file on the lines host.env and the NixOS settings hold.
if [[ ${1-} == --self-test ]]; then
    env_file=$(mktemp)
    trap 'rm -f "$env_file"' EXIT
    cat >"$env_file" <<'EOF'
#PF_TEST_COMMENTED=1
  ; PF_TEST_COMMENTED=2

PUNKTFUNK_HOST_NAME=Living Room
  PF_TEST_PADDED =  two  words
PF_TEST_SINGLE='a "b" $HOME \n'
PF_TEST_DOUBLE="say \"hi\" \$HOME \\ \n"
PF_TEST_ESCAPED=a\ b\\c
PF_TEST_RUN=$(echo ran)
PF_TEST_EMPTY=
not a setting
export PF_TEST_EXPORT=1
EOF
    printf 'PF_TEST_LAST=no newline' >>"$env_file"
    read_env_file "$env_file"
    fails=0
    want() {
        [[ ${!1-unset} == "$2" ]] && return
        echo "seat-session self-test: $1 is '${!1-unset}', not '$2'" >&2
        fails=1
    }
    want PUNKTFUNK_HOST_NAME 'Living Room'
    want PF_TEST_PADDED 'two  words'
    want PF_TEST_SINGLE 'a "b" $HOME \n'
    want PF_TEST_DOUBLE 'say "hi" $HOME \ \n'
    want PF_TEST_ESCAPED 'a b\c'
    want PF_TEST_RUN '$(echo ran)'
    want PF_TEST_EMPTY ''
    want PF_TEST_COMMENTED unset
    want PF_TEST_EXPORT unset
    want PF_TEST_LAST 'no newline'
    # The compositor pick needs a runtime directory and the functions below: a second run.
    run=$(mktemp -d)
    if ! XDG_SESSION_ID=self-test RUNTIME_DIRECTORY=$run PUNKTFUNK_SEAT_OWNER='' \
        PUNKTFUNK_SEAT_OWN_ACCOUNT='' bash "$0" --self-test-desktop; then
        echo "seat-session self-test: a KWin that can't start doesn't hand over to gamescope" >&2
        fails=1
    fi
    rm -rf "$run"
    [[ $fails == 0 ]] && echo "seat-session self-test: ok"
    exit "$fails"
fi

if [[ -z "${XDG_SESSION_ID:-}" || -z "${RUNTIME_DIRECTORY:-}" ]]; then
    echo "seat-session: no logind session or runtime directory; run it from punktfunk-seat@.service" >&2
    exit 1
fi
printf '%s\n' "$XDG_SESSION_ID" >"$RUNTIME_DIRECTORY/session"

OWNER="${PUNKTFUNK_SEAT_OWNER:-}"
# The person's own account: the owner's row, or another person's.
OWN="${PUNKTFUNK_SEAT_OWN_ACCOUNT:-$OWNER}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"

KWIN_PID=""
BUS_PID=""
SHELL_PID=""
cleanup() {
    trap - TERM INT
    # shellcheck disable=SC2046
    kill $(jobs -p) 2>/dev/null
    if [[ -n "$OWN" ]]; then
        # The user's physical plasmashell is the same user's: end only this session's.
        [[ -n "$SHELL_PID" ]] && pkill -TERM -P "$SHELL_PID" 2>/dev/null
        [[ -n "$BUS_PID" ]] && kill "$BUS_PID" 2>/dev/null
    else
        pkill -TERM -u "$(id -u)" plasmashell 2>/dev/null
    fi
    wait 2>/dev/null
    exit 0
}
trap cleanup TERM INT

# The session switches of distros without steamos-manager, for this seat: Steam's fallback and
# Nobara's shortcut call these by name, and they ask the host as steamosctl does. The seat's own
# steamos-manager is masked so the host keeps its name.
install_switch_commands() {
    local bin="$RUNTIME_DIRECTORY/bin"
    mkdir -p "$bin"
    cat >"$bin/steamos-session-select" <<'EOF'
#!/usr/bin/env bash
case "${0##*/} ${1-}" in
"steamos-session-select gamescope" | "steamos-session-select " | "steamos-desktop-return "*)
    method=SwitchToGameMode ;;
"steamos-session-select plasma"* | "steamos-session-select desktop")
    method=SwitchToDesktopMode ;;
"steamos-session-select persistent" | "steamos-session-select oneshot")
    exit 0 ;;
*)
    echo "!! Unrecognized session '${1-}'" >&2
    exit 1 ;;
esac
exec busctl --address="$DBUS_SESSION_BUS_ADDRESS" call com.steampowered.SteamOSManager1 \
    /com/steampowered/SteamOSManager1 com.steampowered.SteamOSManager1.SessionManagement1 "$method"
EOF
    chmod 755 "$bin/steamos-session-select"
    ln -sf steamos-session-select "$bin/steamos-desktop-return"
    export PATH="$bin:$PATH"
    # A person's own account has a bus of its own, where nothing activates it.
    [[ -z "$OWN" ]] && systemctl --user mask --runtime --now steamos-manager.service >/dev/null 2>&1
    return 0
}

# The owner's settings, under the seat contract: the files PUNKTFUNK_OWNER_ENV names (a NixOS
# module's settings, which its user unit takes as EnvironmentFile), then host.env, each read as
# data by read_env_file. The contract's variables keep the values the supervisor wrote. A file the
# owner can't read is skipped.
load_owner_settings() {
    local file key extra=()
    local -A keep=()
    read -ra extra <<<"${PUNKTFUNK_OWNER_ENV:-}"
    for key in PUNKTFUNK_SEAT_SESSION PUNKTFUNK_SEAT_ID PUNKTFUNK_SEAT_OWNER PUNKTFUNK_TRUST_DIR \
        PUNKTFUNK_PAIRING PUNKTFUNK_NATIVE_PORT PUNKTFUNK_MGMT_BIND PUNKTFUNK_MDNS \
        PUNKTFUNK_WEBTRANSPORT PUNKTFUNK_WEBTRANSPORT_PORT PUNKTFUNK_WEBTRANSPORT_ORIGINS; do
        keep[$key]="${!key-}"
    done
    for file in "${extra[@]}" "$HOME/.config/punktfunk/host.env"; do
        [[ -r "$file" ]] && read_env_file "$file"
    done
    for key in "${!keep[@]}"; do
        export "$key=${keep[$key]}"
    done
}

# A bus of its own: the user's shared one holds whatever KWin and portals their login started,
# and a second KWin there would take names the first needs. dbus-daemon prints its address
# and its pid, one per line.
start_private_bus() {
    local out
    out=$(dbus-daemon --session --fork --print-address=1 --print-pid=1 \
        --address="unix:path=$RUNTIME_DIRECTORY/bus") || return 1
    DBUS_SESSION_BUS_ADDRESS=$(printf '%s\n' "$out" | grep -m1 '^unix:')
    BUS_PID=$(printf '%s\n' "$out" | grep -m1 -E '^[0-9]+$')
    export DBUS_SESSION_BUS_ADDRESS
}

# The screencast and input portals on the private bus. Their activation files name systemd units
# of the owner's manager, which this session doesn't use, so the frontend is started by hand and
# activates its KDE backend itself.
start_private_portal() {
    local exe
    for exe in /usr/libexec/xdg-desktop-portal /usr/lib/xdg-desktop-portal \
        /usr/lib64/xdg-desktop-portal /run/current-system/sw/libexec/xdg-desktop-portal; do
        if [[ -x "$exe" ]]; then
            "$exe" >/dev/null 2>&1 &
            return 0
        fi
    done
    echo "seat-session: no xdg-desktop-portal found; input and capture need it" >&2
}

# A login with the password (`punktfunk-seats login`) leaves the KDE wallet waiting for this
# session's bus and compositor, which exist by now. Plasma's autostart doesn't run here; its
# entry names the distro's script.
unlock_wallet() {
    [[ -n "${PAM_KWALLET5_LOGIN:-}" ]] || return 0
    local init="" entry
    for entry in /etc/xdg/autostart/pam_kwallet_init.desktop \
        /run/current-system/sw/etc/xdg/autostart/pam_kwallet_init.desktop; do
        [[ -r "$entry" ]] && init=$(sed -n 's/^Exec=//p' "$entry" | head -n 1) && break
    done
    for init in "$init" /usr/libexec/pam_kwallet_init /usr/lib/pam_kwallet_init \
        /usr/share/libpam-kwallet-common/pam_kwallet_init; do
        if [[ -n "$init" && -x "$init" ]]; then
            "$init" >/dev/null 2>&1 || echo "seat-session: pam_kwallet_init failed" >&2
            return 0
        fi
    done
    echo "seat-session: pam_kwallet_init not found; the wallet stays locked" >&2
}

# Marks the headless host as serving once its management port answers, for the supervisor.
mark_ready_when_serving() {
    local port="${PUNKTFUNK_MGMT_BIND##*:}"
    (
        until (: >"/dev/tcp/127.0.0.1/$port") 2>/dev/null; do sleep 0.5; done
        : >"$RUNTIME_DIRECTORY/ready"
    ) &
}

alive() { [[ -z "$KWIN_PID" ]] || kill -0 "$KWIN_PID" 2>/dev/null; }

# Whether the host finds a gamescope to start, by its own rungs.
has_gamescope() {
    [[ -x ${PUNKTFUNK_GAMESCOPE_BIN:-} || -x ${HOST%/*}/punktfunk-gamescope ]] ||
        command -v punktfunk-gamescope >/dev/null 2>&1 || command -v gamescope >/dev/null 2>&1
}

# KWin where it is installed and comes up; otherwise the host starts gamescope itself.
start_desktop() {
    command -v kwin_wayland >/dev/null 2>&1 && start_kwin
    if [[ -z "$KWIN_PID" ]]; then
        [[ -n "$OWN" && -z "$BUS_PID" ]] && start_private_bus
        export PUNKTFUNK_COMPOSITOR=gamescope
    fi
    return 0
}

# A KWin that exits before it is ready lacks something it needs (Plasma's integration on a GNOME
# box): with gamescope installed it returns 1 with its environment taken back, the private bus
# kept for gamescope. A KWin that dies once ready ends the seat.
start_kwin() {
    # The row shares the user's runtime dir, where a headless KDE session holds wayland-kde.
    # A taken name makes kwin exit.
    local kde=(XDG_CURRENT_DESKTOP=KDE XDG_MENU_PREFIX=plasma- KDE_FULL_SESSION=true
        KDE_SESSION_VERSION=6 DESKTOP_SESSION=plasma
        WAYLAND_DISPLAY=wayland-pf-seat KWIN_WAYLAND_NO_PERMISSION_CHECKS=1
        "PUNKTFUNK_COMPOSITOR=${PUNKTFUNK_COMPOSITOR:-kwin}"
        "PUNKTFUNK_VIDEO_SOURCE=${PUNKTFUNK_VIDEO_SOURCE:-virtual}"
        "PUNKTFUNK_INPUT_BACKEND=${PUNKTFUNK_INPUT_BACKEND:-libei}"
        "PUNKTFUNK_KWIN_VIRTUAL_PRIMARY=${PUNKTFUNK_KWIN_VIRTUAL_PRIMARY:-1}")
    local pair name
    local -A was=()
    for pair in "${kde[@]}"; do
        name=${pair%%=*}
        [[ -n ${!name+set} ]] && was[$name]=${!name}
        export "$name=${pair#*=}"
    done

    [[ -n "$OWN" ]] && start_private_bus
    # Under the 0700 runtime dir: the DISPLAY detection below reads this file.
    local log="$XDG_RUNTIME_DIR/punktfunk-kwin.log"
    : >"$log"
    chmod 600 "$log"
    # kwin hands the apps it starts its public X display; their output lands in the log.
    kwin_wayland --virtual --xwayland --width "$W" --height "$H" --no-lockscreen \
        --socket "$WAYLAND_DISPLAY" "printenv DISPLAY" >"$log" 2>&1 &
    KWIN_PID=$!

    # Ready means kwin offers the screencast global, not that the socket file exists.
    local deadline=$((SECONDS + 30))
    until "$HOST" probe-compositor >/dev/null 2>&1; do
        if ! kill -0 "$KWIN_PID" 2>/dev/null; then
            echo "seat-session: kwin_wayland exited during startup:" >&2
            tail -n 20 "$log" >&2
            has_gamescope || exit 1
            echo "seat-session: the seat runs on gamescope instead" >&2
            KWIN_PID=""
            for pair in "${kde[@]}"; do
                name=${pair%%=*}
                if [[ -n ${was[$name]+set} ]]; then
                    export "$name=${was[$name]}"
                else
                    unset "$name"
                fi
            done
            return 1
        fi
        if ((SECONDS >= deadline)); then
            echo "seat-session: kwin did not become ready within 30s" >&2
            exit 1
        fi
        sleep 0.5
    done

    # Never guess from /tmp/.X11-unix: seats share it, and kwin 6.8 adds its own init display
    # there, on which an X client waits forever.
    local n=""
    for _ in $(seq 1 40); do
        n=$(grep -m1 -xE ':[0-9]+' "$log")
        [[ -n "$n" ]] && break
        sleep 0.25
    done
    if [[ -n "$n" ]]; then
        export DISPLAY="$n"
    else
        echo "seat-session: kwin reported no X display; X11 apps such as Steam won't open" >&2
    fi

    if [[ -n "$OWN" ]]; then
        start_private_portal
        unlock_wallet
        kbuildsycoca6 >/dev/null 2>&1 || true
        start_plasmashell
        return
    fi

    # The portal binds the compositor that existed when it started: import the live env first.
    systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP \
        DBUS_SESSION_BUS_ADDRESS XDG_RUNTIME_DIR ${DISPLAY:+DISPLAY} 2>/dev/null || true
    dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP \
        DBUS_SESSION_BUS_ADDRESS ${DISPLAY:+DISPLAY} 2>/dev/null || true

    # Pre-authorised RemoteDesktop grant: without it the portal asks a question nobody answers.
    local share=/usr/share/punktfunk/headless db="$HOME/.local/share/flatpak/db/kde-authorized"
    # The Debian host package keeps this data under punktfunk-host.
    [[ -d $share ]] || share=/usr/share/punktfunk-host/headless
    if [[ ! -s "$db" && -s "$share/kde-authorized" ]]; then
        mkdir -p "$(dirname "$db")" && cp "$share/kde-authorized" "$db"
    fi
    # The virtual speaker the host captures; PipeWire reads its config at start.
    local sink="$HOME/.config/pipewire/pipewire.conf.d/50-punktfunk-sink.conf"
    if [[ ! -s "$sink" && -s "$share/punktfunk-sink.conf" ]]; then
        mkdir -p "$(dirname "$sink")" && cp "$share/punktfunk-sink.conf" "$sink"
        systemctl --user restart pipewire 2>/dev/null || true
    fi
    # xdg-desktop-portal needs graphical-session.target, which refuses a manual start by default.
    local dropin="$HOME/.config/systemd/user/graphical-session.target.d"
    if [[ ! -f "$dropin/10-punktfunk-headless.conf" ]]; then
        mkdir -p "$dropin"
        printf '[Unit]\nRefuseManualStart=no\n' >"$dropin/10-punktfunk-headless.conf"
        systemctl --user daemon-reload 2>/dev/null || true
    fi
    systemctl --user start graphical-session.target 2>/dev/null || true
    systemctl --user --no-block restart plasma-xdg-desktop-portal-kde.service 2>/dev/null || true
    systemctl --user --no-block start xdg-desktop-portal.service 2>/dev/null || true

    kbuildsycoca6 >/dev/null 2>&1 || true
    start_plasmashell
}

# plasmashell draws the desktop and can crash; restart it for as long as kwin lives. A box with
# kwin but no Plasma runs the seat without it.
start_plasmashell() {
    if ! command -v plasmashell >/dev/null 2>&1; then
        echo "seat-session: plasmashell not installed; the seat has no desktop shell" >&2
        return 0
    fi
    (
        while kill -0 "$KWIN_PID" 2>/dev/null; do
            plasmashell
            sleep 2
        done
    ) &
    SHELL_PID=$!
}

# `seat-session --self-test-desktop`, which --self-test runs: a KWin that exits while it starts
# ends the seat without gamescope, and with it leaves gamescope the environment it found.
if [[ ${1-} == --self-test-desktop ]]; then
    fake=$RUNTIME_DIRECTORY/fake
    mkdir -p "$fake"
    printf '#!/bin/sh\nexit 1\n' >"$fake/kwin_wayland"
    chmod 755 "$fake/kwin_wayland"
    HOST=false XDG_RUNTIME_DIR=$RUNTIME_DIRECTORY
    unset XDG_CURRENT_DESKTOP PUNKTFUNK_COMPOSITOR PUNKTFUNK_GAMESCOPE_BIN
    export WAYLAND_DISPLAY=theirs PUNKTFUNK_VIDEO_SOURCE=mine
    (PATH=$fake start_desktop 2>/dev/null) && exit 1
    cp "$fake/kwin_wayland" "$fake/gamescope"
    PATH=$fake start_desktop 2>/dev/null
    [[ $PUNKTFUNK_COMPOSITOR == gamescope && -z $KWIN_PID && -z ${XDG_CURRENT_DESKTOP+set} &&
        $WAYLAND_DISPLAY == theirs && $PUNKTFUNK_VIDEO_SOURCE == mine ]]
    exit
fi

if [[ -n "$OWNER" ]]; then
    load_owner_settings
    # The owner's own host must not hold the row's ports. Nothing streams their headless desktop
    # while it is down, and a second desktop takes single-instance apps such as Steam.
    systemctl --user stop punktfunk-host.service punktfunk-kde-session.service 2>/dev/null || true
    mark_ready_when_serving
fi
install_switch_commands
start_desktop

# The host restarts on its own, backing off while it fails, for as long as the desktop lives. A
# desktop that dies ends the seat and the unit's Restart= starts it over. PUNKTFUNK_SEAT_HEADLESS
# tells the owner's host it runs here, not at the desk, so Game Mode is its own.
delay=1
while alive; do
    started=$SECONDS
    PUNKTFUNK_SEAT_HEADLESS=1 PUNKTFUNK_MGMT_TOKEN="$TOKEN" "$HOST" serve &
    wait $!
    echo "seat-session: host exited with $?; restarting in ${delay}s" >&2
    # This loop outlives the host, so systemd won't reap what a dead host started. Its gamescope
    # would keep Steam's single instance from the next one. Exact names: gamescopereaper takes
    # Steam down with it. A person's own gamescope may be the one at the desk.
    [[ -z "$OWN" ]] && pkill -KILL -u "$(id -u)" -x 'gamescope(-wl)?' 2>/dev/null
    ((SECONDS - started > 60)) && delay=1
    # A background sleep, so SIGTERM interrupts the wait instead of queueing behind it.
    sleep "$delay" &
    wait $!
    ((delay = delay * 2 > 30 ? 30 : delay * 2))
done
echo "seat-session: the compositor exited" >&2
exit 1
