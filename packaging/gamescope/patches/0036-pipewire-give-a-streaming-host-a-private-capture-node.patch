+static void dispatch_nudge(int fd)
+{
+	while (true) {
+		static char buf[1024];
+		if (read(fd, buf, sizeof(buf)) < 0) {
+			if (errno != EAGAIN)
+				pwr_log.errorf_errno("dispatch_nudge: read failed");
+			break;
+		}
+	}
+
+	for (struct pipewire_state &state : s_states)
+		dispatch_stream(&state);
+}
