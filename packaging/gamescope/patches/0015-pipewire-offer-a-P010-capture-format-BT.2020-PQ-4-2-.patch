diff --git a/src/shaders/cs_rgb_to_p010.comp b/src/shaders/cs_rgb_to_p010.comp
new file mode 100644
index 0000000..ed6ea1c
--- /dev/null
+++ b/src/shaders/cs_rgb_to_p010.comp
@@ -0,0 +1,82 @@
+#version 450
+
+#extension GL_GOOGLE_include_directive : require
+#extension GL_EXT_scalar_block_layout : require
+
+#define DST_LUMA_FORMAT r16
+#define DST_CHROMA_FORMAT rg16
+#include "descriptor_set.h"
+
+layout(
+  local_size_x = 8,
+  local_size_y = 8,
+  local_size_z = 1) in;
+
+// P010 is NV12 with 16-bit samples, the 10-bit code in the high bits:
+// YYYYYYYYYYYYYYY...
+// YYYYYYYYYYYYYYY...
+// UVUVUVUVUVUVUVU...
+//
+// The source is the PQ-encoded BT.2020 composite, fetched as the codes it holds (no sRGB
+// view, no re-encode); u_outputCTM is the limited-range BT.2020 matrix on those codes.
+
+const uint u_frameId = 0;
+const uint u_shaderFilter = filter_linear_emulated;
+const uint u_alphaMode = 0;
+const float u_linearToNits = 400.0f;
+const float u_nitsToLinear = 1.0f / 100.0f;
+const float u_itmSdrNits = 100.f;
+const float u_itmTargetNits = 1000.f;
+
+layout(binding = 0, scalar)
+uniform layers_t {
+    vec2 u_scale[1];
+    vec2 u_offset[1];
+    float u_opacity[1];
+    mat3x4 u_ctm[1];
+    mat3x4 u_outputCTM;
+    uint u_borderMask;
+    uvec2 u_halfExtent;
+};
+
+#include "composite.h"
+
+vec3 fetchLayer(vec2 uv) {
+  ivec2 coord = ivec2((uv + u_offset[0]) * u_scale[0]);
+  ivec2 maxCoord = textureSize(s_samplers[0], 0) - ivec2(1);
+  return texelFetch(s_samplers[0], clamp(coord, ivec2(0), maxCoord), 0).rgb;
+}
+
+// A 10-bit code lands in the top bits of the 16-bit sample; the low six stay zero.
+vec3 toCodes(vec3 yuv) {
+  return vec3(uvec3(round(clamp(yuv, 0.0f, 1.0f) * 1023.0f)) << 6) / 65535.0f;
+}
+
+void main() {
+  ivec3 thread_id = ivec3(gl_GlobalInvocationID);
+
+  if (all(lessThan(thread_id.xy, ivec2(u_halfExtent.x, u_halfExtent.y)))) {
+    vec2 offset_table[4] = {
+      vec2(0, 0), vec2(1, 0), vec2(0, 1), vec2(1, 1),
+    };
+
+    ivec2 chroma_uv = thread_id.xy;
+    vec2 luma_uv = vec2(thread_id.xy * 2);
+
+    vec3 color[4] = {
+      fetchLayer(luma_uv + offset_table[0]),
+      fetchLayer(luma_uv + offset_table[1]),
+      fetchLayer(luma_uv + offset_table[2]),
+      fetchLayer(luma_uv + offset_table[3]),
+    };
+
+    vec3 avg_color = (color[0] + color[1] + color[2] + color[3]) / 4.0f;
+    vec3 uv = toCodes(vec4(avg_color, 1.0f) * u_outputCTM);
+    imageStore(dst_chroma, chroma_uv, vec4(uv.yz, 0.0f, 1.0f));
+
+    for (int i = 0; i < 4; i++) {
+      vec3 y = toCodes(vec4(color[i], 1.0f) * u_outputCTM);
+      imageStore(dst_luma, ivec2(luma_uv + offset_table[i]), vec4(y.x, 0.0f, 0.0f, 1.0f));
+    }
+  }
+}
