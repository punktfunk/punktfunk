diff --git a/src/rendervulkan.cpp b/src/rendervulkan.cpp
index 5a38e5f..8f2a79c 100644
--- a/src/rendervulkan.cpp
+++ b/src/rendervulkan.cpp
@@ -2142,8 +2142,58 @@
 		case VK_IMAGE_TYPE_3D: return VK_IMAGE_VIEW_TYPE_3D;
 		default: abort();
 	}
+}
+
+// A planar capture image and the views its planes are written through. The format itself has no
+// storage feature: the image takes that usage from these views.
+static std::array<VkFormat, 3> planar_capture_formats( uint32_t drmFormat )
+{
+	const bool bTenBit = drmFormat == DRM_FORMAT_P010;
+	return {
+		DRMFormatToVulkan( drmFormat, false ),
+		bTenBit ? VK_FORMAT_R16_UNORM : VK_FORMAT_R8_UNORM,
+		bTenBit ? VK_FORMAT_R16G16_UNORM : VK_FORMAT_R8G8_UNORM,
+	};
 }
+
+EPlanarCaptureAlloc vulkan_get_planar_capture_alloc( uint32_t drmFormat )
+{
+	static constexpr uint32_t k_uNvidiaVendorID = 0x10DE;
+	if ( g_device.vendorID() != k_uNvidiaVendorID )
+		return EPlanarCaptureAlloc::PlainLinear;
+
+	if ( !g_device.supportsModifiers() )
+		return EPlanarCaptureAlloc::Unavailable;
 
+	const std::array<VkFormat, 3> formats = planar_capture_formats( drmFormat );
+	const VkImageFormatListCreateInfo formatList = {
+		.sType = VK_STRUCTURE_TYPE_IMAGE_FORMAT_LIST_CREATE_INFO,
+		.viewFormatCount = uint32_t( formats.size() ),
+		.pViewFormats = formats.data(),
+	};
+	// The usage a PipeWire capture texture is created with.
+	const VkImageCreateInfo imageInfo = {
+		.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+		.pNext = &formatList,
+		.flags = VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT | VK_IMAGE_CREATE_EXTENDED_USAGE_BIT,
+		.imageType = VK_IMAGE_TYPE_2D,
+		.format = formats[0],
+		.tiling = VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT,
+		.usage = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+		.sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+	};
+
+	VkExternalImageFormatProperties externalFormatProps = {
+		.sType = VK_STRUCTURE_TYPE_EXTERNAL_IMAGE_FORMAT_PROPERTIES,
+	};
+	if ( getModifierProps( &imageInfo, DRM_FORMAT_MOD_LINEAR, &externalFormatProps ) != VK_SUCCESS )
+		return EPlanarCaptureAlloc::Unavailable;
+	if ( !( externalFormatProps.externalMemoryProperties.externalMemoryFeatures & VK_EXTERNAL_MEMORY_FEATURE_EXPORTABLE_BIT ) )
+		return EPlanarCaptureAlloc::Unavailable;
+
+	return EPlanarCaptureAlloc::LinearModifier;
+}
+
 std::vector<uint64_t> vulkan_get_capture_modifiers( uint32_t drmFormat )
 {
 	std::vector<uint64_t> modifiers;
@@ -2282,7 +2332,16 @@
 		.pViewFormats = formats.data(),
 	};
 
-	if ( formats[0] != formats[1] )
+	const std::array<VkFormat, 3> planarFormats = planar_capture_formats( drmFormat );
+
+	if ( flags.ulDrmModifier != DRM_FORMAT_MOD_INVALID && ( drmFormat == DRM_FORMAT_NV12 || drmFormat == DRM_FORMAT_P010 ) )
+	{
+		formatList.viewFormatCount = uint32_t( planarFormats.size() );
+		formatList.pViewFormats = planarFormats.data();
+		formatList.pNext = std::exchange(imageInfo.pNext, &formatList);
+		imageInfo.flags |= VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT | VK_IMAGE_CREATE_EXTENDED_USAGE_BIT;
+	}
+	else if ( formats[0] != formats[1] )
 	{
 		formatList.pNext = std::exchange(imageInfo.pNext, &formatList);
 		imageInfo.flags |= VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT;
@@ -2562,10 +2621,11 @@
 
 	// A LINEAR two-plane image has one layout per plane, and the driver may pad the first. The
 	// CPU copy reads through these, and a dmabuf export hands them on to the consumer.
-	if ( tiling == VK_IMAGE_TILING_LINEAR && isYcbcr() )
+	const bool bLinearModifier = tiling == VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT && flags.ulDrmModifier == DRM_FORMAT_MOD_LINEAR;
+	if ( ( tiling == VK_IMAGE_TILING_LINEAR || bLinearModifier ) && isYcbcr() )
 	{
 		const VkImageSubresource lumaSubresource = {
-			.aspectMask = VK_IMAGE_ASPECT_PLANE_0_BIT,
+			.aspectMask = bLinearModifier ? VK_IMAGE_ASPECT_MEMORY_PLANE_0_BIT_EXT : VK_IMAGE_ASPECT_PLANE_0_BIT,
 		};
 		VkSubresourceLayout lumaLayout;
 		g_device.vk.GetImageSubresourceLayout(g_device.device(), m_vkImage, &lumaSubresource, &lumaLayout);
@@ -2574,7 +2634,7 @@
 		m_lumaPitch = lumaLayout.rowPitch;
 
 		const VkImageSubresource chromaSubresource = {
-			.aspectMask = VK_IMAGE_ASPECT_PLANE_1_BIT,
+			.aspectMask = bLinearModifier ? VK_IMAGE_ASPECT_MEMORY_PLANE_1_BIT_EXT : VK_IMAGE_ASPECT_PLANE_1_BIT,
 		};
 		VkSubresourceLayout chromaLayout;
 		g_device.vk.GetImageSubresourceLayout(g_device.device(), m_vkImage, &chromaSubresource, &chromaLayout);
@@ -2708,10 +2768,15 @@
 			},
 		};
 
-		res = g_device.vk.CreateImageView(g_device.device(), &createInfo, nullptr, &m_srgbView);
-		if ( res != VK_SUCCESS ) {
-			vk_errorf( res, "vkCreateImageView failed" );
-			return false;
+		// A planar export is only written, through its plane views below. The whole image has no
+		// storage feature for a view to inherit.
+		if ( !( bLinearModifier && isYcbcr() ) )
+		{
+			res = g_device.vk.CreateImageView(g_device.device(), &createInfo, nullptr, &m_srgbView);
+			if ( res != VK_SUCCESS ) {
+				vk_errorf( res, "vkCreateImageView failed" );
+				return false;
+			}
 		}
 
 		if ( flags.bSampled )
diff --git a/src/rendervulkan.hpp b/src/rendervulkan.hpp
index e6478da..f179b97 100644
--- a/src/rendervulkan.hpp
+++ b/src/rendervulkan.hpp
@@ -131,6 +131,17 @@
 // Modifiers other than LINEAR that a single-plane, exportable storage image of this format can
 // take. Empty without VK_EXT_image_drm_format_modifier.
 std::vector<uint64_t> vulkan_get_capture_modifiers( uint32_t drmFormat );
+
+// How a planar capture dmabuf is allocated. A consumer imports DRM_FORMAT_MOD_LINEAR, which means
+// pitch page kind. On NVIDIA a plain LINEAR image promises neither, and a kind that differs moves
+// bytes below 1 KiB. Unavailable: that driver cannot make the promise, so the format is not offered.
+enum class EPlanarCaptureAlloc
+{
+	PlainLinear,
+	LinearModifier,
+	Unavailable,
+};
+EPlanarCaptureAlloc vulkan_get_planar_capture_alloc( uint32_t drmFormat );
 
 class CVulkanTexture : public gamescope::RcObject
 {
@@ -864,6 +875,7 @@
 
 	inline VkDevice device() { return m_device; }
 	inline VkPhysicalDevice physDev() {return m_physDev; }
+	inline uint32_t vendorID() {return m_uVendorID;}
 	inline VkInstance instance() { return m_instance; }
 	inline VkQueue queue() {return m_queue;}
 	inline VkQueue generalQueue() {return m_generalQueue;}
