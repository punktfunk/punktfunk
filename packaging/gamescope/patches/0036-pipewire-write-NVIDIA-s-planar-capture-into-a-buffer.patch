+#extension GL_GOOGLE_include_directive : require
+#extension GL_EXT_scalar_block_layout : require
+
+#include "descriptor_set.h"
+
+layout(
+  local_size_x = 8,
+  local_size_y = 8,
+  local_size_z = 1) in;
+
+// cs_rgb_to_nv12 into a storage buffer: Y rows at u_pitchWords, then the UV rows at
+// u_chromaOffsetWords. One invocation owns 4x2 luma pixels and their two chroma samples, so
+// every store is a whole word and no two invocations share one.
+
+const uint u_frameId = 0;
+const uint u_shaderFilter = filter_linear_emulated;
+const uint u_alphaMode = 0;
+const float u_linearToNits = 400.0f;
+const float u_nitsToLinear = 1.0f / 100.0f;
+const float u_itmSdrNits = 100.f;
+const float u_itmTargetNits = 1000.f;
+
+layout(binding = 0, scalar)
+uniform layers_t {
+    vec2 u_scale[1];
+    vec2 u_offset[1];
+    float u_opacity[1];
+    mat3x4 u_ctm[1];
+    mat3x4 u_outputCTM;
+    uint u_borderMask;
+    uvec2 u_halfExtent;
+    uint u_pitchWords;
+    uint u_chromaOffsetWords;
+};
+
+layout(binding = 7, std430) writeonly buffer planar_t {
+    uint dst_words[];
+};
+
+#include "composite.h"
+
+vec4 sampleLayer(uint layerIdx, vec2 uv) {
+  return sampleLayer(s_samplers[layerIdx], layerIdx, uv, true);
+}
+
+vec3 applyColorMatrix(vec3 rgb, mat3x4 matrix) {
+  return vec4(linearToSrgb(rgb), 1.0f) * matrix;
+}
+
+void main() {
+  uvec2 thread_id = gl_GlobalInvocationID.xy;
+
+  if (thread_id.x * 2 >= u_halfExtent.x || thread_id.y >= u_halfExtent.y)
+    return;
+
+  vec4 luma[2];
+  vec4 chroma;
+  for (uint half_block = 0; half_block < 2; half_block++) {
+    vec2 luma_uv = vec2(thread_id.x * 4 + half_block * 2, thread_id.y * 2) + vec2(0.5f, 0.5f);
+
+    vec3 top_left = sampleLayer(0, luma_uv).rgb;
+    vec3 top_right = sampleLayer(0, luma_uv + vec2(1, 0)).rgb;
+    vec3 bottom_left = sampleLayer(0, luma_uv + vec2(0, 1)).rgb;
+    vec3 bottom_right = sampleLayer(0, luma_uv + vec2(1, 1)).rgb;
+
+    // Left-sited chroma (H.273 type 0, what decoders assume): [1 2 1] across columns x-1..x+1.
+    vec3 left_top = sampleLayer(0, luma_uv + vec2(-1, 0)).rgb;
+    vec3 left_bottom = sampleLayer(0, luma_uv + vec2(-1, 1)).rgb;
+    vec3 avg_color = (left_top + 2.0f * top_left + top_right +
+                      left_bottom + 2.0f * bottom_left + bottom_right) / 8.0f;
+    vec2 uv = applyColorMatrix(avg_color, u_outputCTM).yz;
+
+    uint lane = half_block * 2;
+    luma[0][lane] = applyColorMatrix(top_left, u_outputCTM).x;
+    luma[0][lane + 1] = applyColorMatrix(top_right, u_outputCTM).x;
+    luma[1][lane] = applyColorMatrix(bottom_left, u_outputCTM).x;
+    luma[1][lane + 1] = applyColorMatrix(bottom_right, u_outputCTM).x;
+    chroma[lane] = uv.x;
+    chroma[lane + 1] = uv.y;
+  }
+
+  uint row = thread_id.y * 2 * u_pitchWords + thread_id.x;
+  dst_words[row] = packUnorm4x8(luma[0]);
+  dst_words[row + u_pitchWords] = packUnorm4x8(luma[1]);
+  dst_words[u_chromaOffsetWords + thread_id.y * u_pitchWords + thread_id.x] = packUnorm4x8(chroma);
+}
