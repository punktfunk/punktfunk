+#version 450
+
+#extension GL_GOOGLE_include_directive : require
+#extension GL_EXT_scalar_block_layout : require
+
+#include "descriptor_set.h"
+
+layout(
+  local_size_x = 8,
+  local_size_y = 8,
+  local_size_z = 1) in;
+
+// cs_rgb_to_p010 into a storage buffer: Y rows at u_pitchWords, then the UV rows at
+// u_chromaOffsetWords. One invocation owns a 2x2 block: two 16-bit samples per luma row and
+// one UV pair are whole words, and no two invocations share one.
+
+const uint u_frameId = 0;
+const uint u_shaderFilter = filter_linear_emulated;
+const uint u_alphaMode = 0;
+const float u_linearToNits = 400.0f;
+const float u_nitsToLinear = 1.0f / 100.0f;
+const float u_itmSdrNits = 100.f;
+const float u_itmTargetNits = 1000.f;
+
+layout(binding = 0, scalar)
+uniform layers_t {
+    vec2 u_scale[1];
+    vec2 u_offset[1];
+    float u_opacity[1];
+    mat3x4 u_ctm[1];
+    mat3x4 u_outputCTM;
+    uint u_borderMask;
+    uvec2 u_halfExtent;
+    uint u_pitchWords;
+    uint u_chromaOffsetWords;
+};
+
+layout(binding = 7, std430) writeonly buffer planar_t {
+    uint dst_words[];
+};
+
+#include "composite.h"
+
+vec3 fetchLayer(vec2 uv) {
+  ivec2 coord = ivec2((uv + u_offset[0]) * u_scale[0]);
+  ivec2 maxCoord = textureSize(s_samplers[0], 0) - ivec2(1);
+  return texelFetch(s_samplers[0], clamp(coord, ivec2(0), maxCoord), 0).rgb;
+}
+
+// A 10-bit code lands in the top bits of the 16-bit sample; the low six stay zero.
+uvec3 toCodes(vec3 yuv) {
+  return uvec3(round(clamp(yuv, 0.0f, 1.0f) * 1023.0f)) << 6;
+}
+
+uint lumaCode(vec3 rgb) {
+  return toCodes(vec4(rgb, 1.0f) * u_outputCTM).x;
+}
+
+void main() {
+  uvec2 thread_id = gl_GlobalInvocationID.xy;
+
+  if (thread_id.x >= u_halfExtent.x || thread_id.y >= u_halfExtent.y)
+    return;
+
+  vec2 luma_uv = vec2(thread_id * 2);
+
+  vec3 top_left = fetchLayer(luma_uv);
+  vec3 top_right = fetchLayer(luma_uv + vec2(1, 0));
+  vec3 bottom_left = fetchLayer(luma_uv + vec2(0, 1));
+  vec3 bottom_right = fetchLayer(luma_uv + vec2(1, 1));
+
+  // Left-sited chroma (H.273 type 0, what decoders assume): [1 2 1] across columns x-1..x+1.
+  vec3 left_top = fetchLayer(luma_uv + vec2(-1, 0));
+  vec3 left_bottom = fetchLayer(luma_uv + vec2(-1, 1));
+  vec3 avg_color = (left_top + 2.0f * top_left + top_right +
+                    left_bottom + 2.0f * bottom_left + bottom_right) / 8.0f;
+  uvec3 uv = toCodes(vec4(avg_color, 1.0f) * u_outputCTM);
+
+  uint row = thread_id.y * 2 * u_pitchWords + thread_id.x;
+  dst_words[row] = lumaCode(top_left) | (lumaCode(top_right) << 16);
+  dst_words[row + u_pitchWords] = lumaCode(bottom_left) | (lumaCode(bottom_right) << 16);
+  dst_words[u_chromaOffsetWords + thread_id.y * u_pitchWords + thread_id.x] = uv.y | (uv.z << 16);
+}
