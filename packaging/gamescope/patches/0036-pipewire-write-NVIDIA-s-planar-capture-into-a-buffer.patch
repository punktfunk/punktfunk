+// Luma rows, then chroma rows, at one pitch, in exportable device memory. Pitches and offsets are
+// whole words for the pass; 256-byte rows and a page-aligned chroma suit every importer.
+bool CVulkanTexture::BInitPlanarBuffer( uint32_t width, uint32_t height, uint32_t drmFormat )
+{
+	assert( drmFormat == DRM_FORMAT_NV12 || drmFormat == DRM_FORMAT_P010 );
+
+	m_drmFormat = drmFormat;
+	m_format = DRMFormatToVulkan( drmFormat, false );
+	m_width = m_contentWidth = width;
+	m_height = m_contentHeight = height;
+	m_depth = 1;
+	m_bExternal = true;
+
+	const uint32_t uSampleBytes = drmFormat == DRM_FORMAT_P010 ? 2 : 1;
+	m_lumaOffset = 0;
+	m_lumaPitch = m_chromaPitch = align( width * uSampleBytes, 256u );
+	m_chromaOffset = align( m_lumaPitch * height, 4096u );
+	m_size = m_chromaOffset + VkDeviceSize( m_chromaPitch ) * ( ( height + 1 ) / 2 );
+
+	const VkExternalMemoryBufferCreateInfo externalInfo = {
+		.sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_BUFFER_CREATE_INFO,
+		.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+	};
+	const VkBufferCreateInfo bufferInfo = {
+		.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+		.pNext = &externalInfo,
+		.size = m_size,
+		.usage = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT,
+		.sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+	};
+	VkResult res = g_device.vk.CreateBuffer( g_device.device(), &bufferInfo, nullptr, &m_vkPlanarBuffer );
+	if ( res != VK_SUCCESS )
+	{
+		vk_errorf( res, "vkCreateBuffer failed" );
+		return false;
+	}
+
+	VkMemoryRequirements memRequirements;
+	g_device.vk.GetBufferMemoryRequirements( g_device.device(), m_vkPlanarBuffer, &memRequirements );
+	const int32_t nMemoryType = g_device.findMemoryType( VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, memRequirements.memoryTypeBits );
+	if ( nMemoryType < 0 )
+	{
+		vk_log.errorf( "no device-local memory type for a planar capture buffer" );
+		return false;
+	}
+
+	const VkExportMemoryAllocateInfo exportInfo = {
+		.sType = VK_STRUCTURE_TYPE_EXPORT_MEMORY_ALLOCATE_INFO,
+		.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+	};
+	const VkMemoryDedicatedAllocateInfo dedicatedInfo = {
+		.sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO,
+		.pNext = &exportInfo,
+		.buffer = m_vkPlanarBuffer,
+	};
+	const VkMemoryAllocateInfo allocInfo = {
+		.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+		.pNext = &dedicatedInfo,
+		.allocationSize = memRequirements.size,
+		.memoryTypeIndex = uint32_t( nMemoryType ),
+	};
+	res = g_device.vk.AllocateMemory( g_device.device(), &allocInfo, nullptr, &m_vkImageMemory );
+	if ( res != VK_SUCCESS )
+	{
+		vk_errorf( res, "vkAllocateMemory failed" );
+		return false;
+	}
+
+	res = g_device.vk.BindBufferMemory( g_device.device(), m_vkPlanarBuffer, m_vkImageMemory, 0 );
+	if ( res != VK_SUCCESS )
+	{
+		vk_errorf( res, "vkBindBufferMemory failed" );
+		return false;
+	}
+
+	struct wlr_dmabuf_attributes dmabuf = {
+		.width = int( width ),
+		.height = int( height ),
+		.format = drmFormat,
+		.modifier = DRM_FORMAT_MOD_LINEAR,
+		.n_planes = 2,
+		.offset = { m_lumaOffset, m_chromaOffset },
+		.stride = { m_lumaPitch, m_chromaPitch },
+	};
+	const VkMemoryGetFdInfoKHR getFdInfo = {
+		.sType = VK_STRUCTURE_TYPE_MEMORY_GET_FD_INFO_KHR,
+		.memory = m_vkImageMemory,
+		.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+	};
+	res = g_device.vk.GetMemoryFdKHR( g_device.device(), &getFdInfo, &dmabuf.fd[0] );
+	if ( res != VK_SUCCESS )
+	{
+		vk_errorf( res, "vkGetMemoryFdKHR failed" );
+		return false;
+	}
+	dmabuf.fd[1] = dup( dmabuf.fd[0] );
+	if ( dmabuf.fd[1] < 0 )
+	{
+		vk_log.errorf_errno( "dup failed" );
+		close( dmabuf.fd[0] );
+		return false;
+	}
+	m_dmabuf = dmabuf;
+
+	m_bInitialized = true;
+	return true;
+}
