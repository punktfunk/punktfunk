From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: unom <packages@unom.io>
Date: Thu, 12 Nov 2026 16:57:20 +0100
Subject: [PATCH 37/38] pipewire: paint the focus window's popups and
 subsurfaces into the capture

paint_window() draws a window's subsurfaces and xdg popups only for the
base plane, which the scanout paints and the capture does not: BasePlane
also rewrites the scanout's cached plane. A consumer of the node then sees
a native Wayland app without its menus, dropdowns and tooltips.

Add a SurfaceTree flag that asks for the tree alone, and pass it for the
capture's focus window. The layers take the parent's transform, so they
land at the capture's own scale.

They change apart from the toplevel's commits, so the repaint test folds
the tree in: every popup and subsurface, its buffer and its position,
plus a count of their commits for a client that commits one buffer twice.
A popup that closes without another commit is erased as well.

vulkan_screenshot() waits on each such layer's acquire point, as
vulkan_composite() does.
---
 src/rendervulkan.cpp |  8 +++++++
 src/steamcompmgr.cpp | 54 ++++++++++++++++++++++++++++++++++++++++++--
 2 files changed, 60 insertions(+), 2 deletions(-)

diff --git a/src/rendervulkan.cpp b/src/rendervulkan.cpp
index 19c15d96..433cd15f 100644
--- a/src/rendervulkan.cpp
+++ b/src/rendervulkan.cpp
@@ -4574,6 +4574,14 @@ std::optional<uint64_t> vulkan_screenshot( const struct FrameInfo_t *frameInfo,
 
 	auto cmdBuffer = g_device.commandBuffer();
 
+	// A popup or subsurface layer is fenced by its client's acquire point, as in vulkan_composite.
+	for ( int i = 0; i < frameInfo->layers.count(); i++ )
+	{
+		const FrameInfo_t::Layer_t &layer = frameInfo->layers.get( i );
+		if ( layer.acquirePoint )
+			cmdBuffer->AddDependency( layer.acquirePoint->GetTimeline()->ToVkSemaphore(), layer.acquirePoint->GetPoint() );
+	}
+
 	for (uint32_t i = 0; i < EOTF_Count; i++)
 		cmdBuffer->bindColorMgmtLuts(i, frameInfo->shaperLut[i], frameInfo->lut3D[i]);
 
diff --git a/src/steamcompmgr.cpp b/src/steamcompmgr.cpp
index 7acd15ba..14670157 100644
--- a/src/steamcompmgr.cpp
+++ b/src/steamcompmgr.cpp
@@ -2578,9 +2578,14 @@ namespace PaintWindowFlag
 	static const uint32_t CoverageMode = 1u << 6;
 	static const uint32_t ClampToOutput = 1u << 7;
 	static const uint32_t SubpixelOffsets = 1u << 8;
+	// The window's subsurfaces and popups, without BasePlane's writes to the scanout's cache.
+	static const uint32_t SurfaceTree = 1u << 9;
 }
 using PaintWindowFlags = uint32_t;
 
+// Counts popup and subsurface commits; the capture repaints when it moves.
+static uint64_t s_ulNonToplevelCommitSerial = 0;
+
 wlserver_vk_swapchain_feedback* steamcompmgr_get_base_layer_swapchain_feedback()
 {
 	global_focus_t *pFocus = GetCurrentFocus();
@@ -2920,7 +2925,7 @@ paint_window(global_focus_t *pFocus, steamcompmgr_win_t *w, steamcompmgr_win_t *
 
 	// Subsurfaces and popups are painted here instead of paint_all so their
 	// layers are drawn above the base plane they belong to.
-	if ( layer && ( flags & PaintWindowFlag::BasePlane ) && lastCommit )
+	if ( layer && ( flags & ( PaintWindowFlag::BasePlane | PaintWindowFlag::SurfaceTree ) ) && lastCommit )
 	{
 		struct wlr_surface *rootSurface = lastCommit->surf;
 		if ( rootSurface )
@@ -3052,10 +3057,49 @@ struct PipewirePaint_t
 	uint64_t ulLastCursorImage = 0;
 	uint64_t ulLastExternalOverlayCommitId = 0;
 	uint64_t ulLastOverlayCommitId = 0;
+	uint64_t ulLastSurfaceTreeId = 0;
 	uint64_t ulNextPushNs = 0;
 };
 static PipewirePaint_t s_PipewirePaint[ (size_t) PipewireStream::Count ];
 
+// A native Wayland window's popups and subsurfaces commit apart from its toplevel, and a popup
+// can leave without any commit. This folds each one's surface, buffer and place into one value.
+// The toplevel itself stays out: its buffer changes before its commit is done.
+static uint64_t window_surface_tree_id( steamcompmgr_win_t *w )
+{
+	if ( !w || w->type != steamcompmgr_win_type_t::XDG )
+		return 0;
+
+	struct TreeId_t
+	{
+		struct wlr_surface *pRoot;
+		uint64_t ulId;
+	} tree = { nullptr, s_ulNonToplevelCommitSerial };
+
+	wlserver_lock();
+	tree.pRoot = w->main_surface();
+	struct wlr_xdg_surface *pXdgSurface = tree.pRoot ? wlr_xdg_surface_try_from_wlr_surface( tree.pRoot ) : nullptr;
+	if ( pXdgSurface )
+	{
+		wlr_xdg_surface_for_each_surface( pXdgSurface,
+			[]( struct wlr_surface *pSurface, int nX, int nY, void *pData )
+			{
+				TreeId_t *pTree = static_cast<TreeId_t *>( pData );
+				if ( pSurface == pTree->pRoot )
+					return;
+
+				VulkanWlrTexture_t *pTex = (VulkanWlrTexture_t *) wlr_surface_get_texture( pSurface );
+				const uint64_t ulParts[] = { uint64_t( uintptr_t( pSurface ) ), uint64_t( uintptr_t( pTex ? pTex->buf : nullptr ) ),
+					uint64_t( uint32_t( nX ) ), uint64_t( uint32_t( nY ) ) };
+				for ( uint64_t ulPart : ulParts )
+					pTree->ulId = pTree->ulId * 31 + ulPart;
+			}, &tree );
+	}
+	wlserver_unlock();
+
+	return tree.ulId;
+}
+
 static void paint_pipewire( PipewireStream eStream )
 {
 	PipewirePaint_t &paint = s_PipewirePaint[ (size_t) eStream ];
@@ -3223,12 +3267,16 @@ static void paint_pipewire( PipewireStream eStream )
 		? pFocus->overlayWindow : nullptr;
 	const uint64_t ulOverlayCommitId = window_last_done_commit_id( pOverlay );
 
+	// So do the focus window's popups and subsurfaces: a menu opens over a still window.
+	const uint64_t ulSurfaceTreeId = window_surface_tree_id( pFocus->focusWindow );
+
 	if ( ulFocusCommitId == s_ulLastFocusCommitId &&
 	     ulOverrideCommitId == s_ulLastOverrideCommitId &&
 	     ulUnderlayCommitId == s_ulLastUnderlayCommitId &&
 	     ulDecorationCommitId == s_ulLastDecorationCommitId &&
 	     ulExternalOverlayCommitId == s_ulLastExternalOverlayCommitId &&
 	     ulOverlayCommitId == s_ulLastOverlayCommitId &&
+	     ulSurfaceTreeId == paint.ulLastSurfaceTreeId &&
 	     bDrawCursor == s_bLastCursorDrawn &&
 	     nCursorX == s_nLastCursorX && nCursorY == s_nLastCursorY &&
 	     ulCursorImage == s_ulLastCursorImage )
@@ -3258,6 +3306,7 @@ static void paint_pipewire( PipewireStream eStream )
 	s_ulLastDecorationCommitId = ulDecorationCommitId;
 	s_ulLastExternalOverlayCommitId = ulExternalOverlayCommitId;
 	s_ulLastOverlayCommitId = ulOverlayCommitId;
+	paint.ulLastSurfaceTreeId = ulSurfaceTreeId;
 	s_bLastCursorDrawn = bDrawCursor;
 	s_nLastCursorX = nCursorX;
 	s_nLastCursorY = nCursorY;
@@ -3296,7 +3345,7 @@ static void paint_pipewire( PipewireStream eStream )
 		paint_cached_base_layer( pFocus->HeldCommits[ HELD_COMMIT_BASE ], base, &frameInfo, 1.0f, true );
 	}
 	else
-		paint_window( pFocus, pFocus->focusWindow, pFocus->focusWindow, &frameInfo, nullptr, 0, 1.0f, fit );
+		paint_window( pFocus, pFocus->focusWindow, pFocus->focusWindow, &frameInfo, nullptr, PaintWindowFlag::SurfaceTree, 1.0f, fit );
 
 	if ( !pFocus->focusWindow->isSteamStreamingClient )
 		paint_override_underlays( pFocus, pFocus->focusWindow, &frameInfo, nullptr, nReservedLayers );
@@ -9331,6 +9380,7 @@ static void check_new_non_toplevel_res()
 		return;
 
 	hasRepaint = true;
+	s_ulNonToplevelCommitSerial++;
 
 	// paint_surface_layer only looks textures up by buffer, so a commit whose
 	// texture has not been imported yet would not be drawn at all.
