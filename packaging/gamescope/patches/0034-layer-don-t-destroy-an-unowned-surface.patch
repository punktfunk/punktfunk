From 0a0f7d1b3933aca52abcda2f05e8b76735d8401a Mon Sep 17 00:00:00 2001
From: PancakeTAS <pancake@mgnet.work>
Date: Mon, 14 Sep 2026 23:31:16 +0200
Subject: [PATCH 34/34] layer: don't destroy an unowned surface

(cherry picked from commit f6b6b7d7caf317ba6370e4a530b91d72bcebcf88)

punktfunk: also stamps the version banner +pfhdr28.
---
 layer/VkLayer_FROG_gamescope_wsi.cpp | 7 ++++++-
 src/meson.build                      | 3 ++-
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/layer/VkLayer_FROG_gamescope_wsi.cpp b/layer/VkLayer_FROG_gamescope_wsi.cpp
index 1225026..44d3986 100644
--- a/layer/VkLayer_FROG_gamescope_wsi.cpp
+++ b/layer/VkLayer_FROG_gamescope_wsi.cpp
@@ -428,6 +428,7 @@ namespace GamescopeWSILayer {
     GamescopeWaylandObjects waylandObjects;
     VkSurfaceKHR fallbackSurface;
     wl_surface* surface;
+    bool isNativeSurface;
 
     xcb_connection_t* connection;
     xcb_window_t window;
@@ -815,6 +816,7 @@ namespace GamescopeWSILayer {
         .display         = pCreateInfo->display,
         .waylandObjects  = waylandObjects,
         .surface         = pCreateInfo->surface,
+        .isNativeSurface = true,
         .flags           = gamescopeInstance->flags,
         .hdrOutput       = false, // XXXX FIXME FIXME FIXME //hdrOutput,
       });
@@ -1001,7 +1003,9 @@ namespace GamescopeWSILayer {
       const VkAllocationCallbacks*       pAllocator) {
       if (auto state = GamescopeSurface::get(surface)) {
         pDispatch->DestroySurfaceKHR(instance, state->fallbackSurface, pAllocator);
-        wl_surface_destroy(state->surface);
+        if (!state->isNativeSurface) {
+          wl_surface_destroy(state->surface);
+        }
       }
       GamescopeSurface::remove(surface);
       pDispatch->DestroySurfaceKHR(instance, surface, pAllocator);
@@ -1107,6 +1111,7 @@ namespace GamescopeWSILayer {
         .waylandObjects  = waylandObjects,
         .fallbackSurface = fallbackSurface,
         .surface         = waylandSurface,
+        .isNativeSurface = false,
         .connection      = connection,
         .window          = window,
         .flags           = flags,
diff --git a/src/meson.build b/src/meson.build
index 8b9e3aa..5c758f1 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -208,7 +208,8 @@ vcs_tag = run_command(vcs_tag_cmd, check: false).stdout().strip()
 #   +pfhdr25 — …and a planar capture composites through device memory, not system RAM
 #   +pfhdr26 — …and the 10-bit capture formats are offered as SDR (BT.709) too
 #   +pfhdr27 — …and --framerate-limit is the floor a refresh-cycle request for 0 falls back to
-version_tag = vcs_tag + '+pfhdr27' + ' (' + compiler_name + ' ' + compiler_version + ')'
+#   +pfhdr28 — …and the WSI layer accepts its socket under a container alias
+version_tag = vcs_tag + '+pfhdr28' + ' (' + compiler_name + ' ' + compiler_version + ')'
 
 gamescope_version_conf = configuration_data()
 gamescope_version_conf.set('VCS_TAG', version_tag)
-- 
