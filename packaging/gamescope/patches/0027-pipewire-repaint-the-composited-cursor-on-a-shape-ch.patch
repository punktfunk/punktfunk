From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Enrico=20B=C3=BChler?= <enrico.buehler@unom.io>
Date: Fri, 25 Sep 2026 02:08:49 +0000
Subject: [PATCH 27/33] pipewire: repaint the composited cursor on a shape
 change or a hide

`--pipewire-composite-cursor` repaints the capture when the pointer moves
or its drawn state changes. A shape change without motion (a busy cursor,
a click that swaps the arrow for an I-beam) makes no commit and moves
nothing, so the old shape stayed in the stream on a still screen.

The test also asked `ShouldDrawCursor()`, which is policy only: it ignores
an empty image and `bCursorHidden`, while `MouseCursor::paint` draws
nothing for either. A cursor hidden without moving was never erased.

`MouseCursor` now counts its image rebuilds. The repaint test compares
that count, and a hidden or empty image counts as not drawn, as in the
paint.
---
 src/steamcompmgr.cpp | 12 ++++++++++--
 src/steamcompmgr.hpp |  3 +++
 2 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/src/steamcompmgr.cpp b/src/steamcompmgr.cpp
index 2d33aa0..0a3948c 100644
--- a/src/steamcompmgr.cpp
+++ b/src/steamcompmgr.cpp
@@ -2334,6 +2334,7 @@ bool MouseCursor::getTexture()
 		cursorBuffer.clear();
 
 	m_imageEmpty = bNoCursor;
+	m_ulImageGeneration++;
 
 	m_dirty = false;
 	updateCursorFeedback();
@@ -3003,6 +3004,7 @@ static void paint_pipewire()
 	static bool s_bLastCursorDrawn = false;
 	static int s_nLastCursorX = 0;
 	static int s_nLastCursorY = 0;
+	static uint64_t s_ulLastCursorImage = 0;
 
 	uint64_t ulFocusCommitId = window_last_done_commit_id( pFocus->focusWindow );
 	uint64_t ulOverrideCommitId = window_last_done_commit_id( pFocus->overrideWindow );
@@ -3029,14 +3031,18 @@ static void paint_pipewire()
 	MouseCursor *pCursor = pGlobalFocus ? pGlobalFocus->cursor : nullptr;
 	bool bDrawCursor = false;
 	int nCursorX = 0, nCursorY = 0;
+	uint64_t ulCursorImage = 0;
 	if ( pCursor )
 	{
 		pCursor->undirty();
-		bDrawCursor = ShouldDrawCursor();
+		// `paint()` draws nothing for an empty or hidden image; the test must agree, or a hide on
+		// a still screen would never erase the composited pointer.
+		bDrawCursor = ShouldDrawCursor() && !pCursor->isHidden();
 		if ( bDrawCursor )
 		{
 			nCursorX = pCursor->x();
 			nCursorY = pCursor->y();
+			ulCursorImage = pCursor->imageGeneration();
 		}
 	}
 
@@ -3069,7 +3075,8 @@ static void paint_pipewire()
 	     ulExternalOverlayCommitId == s_ulLastExternalOverlayCommitId &&
 	     ulOverlayCommitId == s_ulLastOverlayCommitId &&
 	     bDrawCursor == s_bLastCursorDrawn &&
-	     nCursorX == s_nLastCursorX && nCursorY == s_nLastCursorY )
+	     nCursorX == s_nLastCursorX && nCursorY == s_nLastCursorY &&
+	     ulCursorImage == s_ulLastCursorImage )
 		return;
 
 	// The consumer's `maxFramerate` is the rate it can use; with adaptive sync every game commit
@@ -3099,6 +3106,7 @@ static void paint_pipewire()
 	s_bLastCursorDrawn = bDrawCursor;
 	s_nLastCursorX = nCursorX;
 	s_nLastCursorY = nCursorY;
+	s_ulLastCursorImage = ulCursorImage;
 
 	uint32_t uWidth = s_pPipewireBuffer->texture->width();
 	uint32_t uHeight = s_pPipewireBuffer->texture->height();
diff --git a/src/steamcompmgr.hpp b/src/steamcompmgr.hpp
index c1d1ab0..b659b6c 100644
--- a/src/steamcompmgr.hpp
+++ b/src/steamcompmgr.hpp
@@ -88,6 +88,8 @@ public:
 
 	bool isHidden() { return wlserver.bCursorHidden || m_imageEmpty; }
 	bool imageEmpty() const { return m_imageEmpty; }
+	// Bumped on every image rebuild, so a capture can tell a new shape from a moved one.
+	uint64_t imageGeneration() const { return m_ulImageGeneration; }
 
 	void undirty() { getTexture(); }
 
@@ -116,6 +118,7 @@ private:
 	uint64_t m_ulLastConnectorId = 0;
 	uint64_t m_ulImageSerial = 0;
 	bool m_imageEmpty;
+	uint64_t m_ulImageGeneration = 0;
 
 	xwayland_ctx_t *m_ctx;
 
