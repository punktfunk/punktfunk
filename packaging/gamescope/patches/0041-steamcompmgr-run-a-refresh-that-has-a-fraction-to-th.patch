From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: unom <packages@unom.io>
Date: Sun, 15 Nov 2026 21:50:38 +0000
Subject: [PATCH 41/42] steamcompmgr: run a refresh that has a fraction to the
 millihertz

A headless gamescope serves a client whose panel runs 59.94 Hz, and a
60 Hz session against it drops a frame every 17 seconds. The clocks in
here count millihertz already; two places rounded it away.

-r read whole hertz. It takes a decimal now, so 59.94 reaches the vblank
timer as 59940 mHz.

Under adaptive sync the frame limiter built its cycle from the whole
target, 60 fps under a 59.94 Hz display. A target that divides the
refresh now takes the refresh's own cycle times that divisor: 59.94 fps
there, 29.97 under half of it. A target that does not divide the refresh
keeps the whole-hertz cycle.
---
 src/main.cpp         | 6 ++++--
 src/steamcompmgr.cpp | 7 ++++++-
 2 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/src/main.cpp b/src/main.cpp
index cf481c40..9f01430b 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -1,5 +1,6 @@
 #include "Script/Script.h"
 
+#include <cmath>
 #include <X11/Xlib.h>
 
 #include <cstdio>
@@ -176,7 +177,7 @@ const char usage[] =
 	"  -H, --output-height            output height\n"
 	"  -w, --nested-width             game width\n"
 	"  -h, --nested-height            game height\n"
-	"  -r, --nested-refresh           game refresh rate (frames per second)\n"
+	"  -r, --nested-refresh           game refresh rate (frames per second, may have a fraction)\n"
 	"  -m, --max-scale                maximum scale factor\n"
 	"  -S, --scaler                   upscaler type (auto, integer, fit, fill, stretch)\n"
 	"  -F, --filter                   upscaler filter (linear, nearest, fsr, nis, pixel, sgsr)\n"
@@ -786,7 +787,8 @@ int main(int argc, char **argv)
 				g_nNestedHeight = parse_integer( optarg, "nested-height" );
 				break;
 			case 'r':
-				g_nNestedRefresh = gamescope::ConvertHztomHz( parse_integer( optarg, "nested-refresh" ) );
+				// A refresh with a fraction (59.94) stays one: every clock below counts in mHz.
+				g_nNestedRefresh = int( lroundf( parse_float( optarg, "nested-refresh" ) * 1000.0f ) );
 				if ( g_nNestedRefresh < 0 )
 				{
 					fprintf( stderr, "gamescope: invalid value for --nested-refresh, must be >= 0\n" );
diff --git a/src/steamcompmgr.cpp b/src/steamcompmgr.cpp
index 14670157..8d068e40 100644
--- a/src/steamcompmgr.cpp
+++ b/src/steamcompmgr.cpp
@@ -11233,7 +11233,12 @@ steamcompmgr_main(int argc, char **argv)
 
 				if ( GetBackend()->GetCurrentConnector() && GetBackend()->GetCurrentConnector()->IsVRRActive() )
 				{
-					g_SteamCompMgrLimitedAppRefreshCycle = gamescope::mHzToRefreshCycle( gamescope::ConvertHztomHz( nTargetFPS ) );
+					// A target that divides the refresh keeps the refresh's fraction: 59.94 fps
+					// under a 59.94 Hz display, 29.97 under half of it. Any other is whole.
+					if ( nTargetFPS > 0 && nRealRefreshHz % nTargetFPS == 0 )
+						g_SteamCompMgrLimitedAppRefreshCycle = g_SteamCompMgrAppRefreshCycle * ( nRealRefreshHz / nTargetFPS );
+					else
+						g_SteamCompMgrLimitedAppRefreshCycle = gamescope::mHzToRefreshCycle( gamescope::ConvertHztomHz( nTargetFPS ) );
 				}
 				else
 				{
