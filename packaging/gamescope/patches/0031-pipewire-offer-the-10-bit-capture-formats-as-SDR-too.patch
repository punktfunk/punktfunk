 #if GAMESCOPE_PIPEWIRE_HDR
-static bool is_hdr_video_format(uint32_t format)
+// The 10-bit formats. Each is offered twice: as the BT.2020 + PQ container and as SDR in
+// BT.709, so the format alone says nothing about the colorimetry; the negotiated transfer
+// function does (is_hdr_stream).
+static bool is_ten_bit_video_format(uint32_t format)
