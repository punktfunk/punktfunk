+	build_format_params(builder, SPA_VIDEO_FORMAT_xBGR_210LE, params, nullptr, false);
+	build_format_params(builder, SPA_VIDEO_FORMAT_xRGB_210LE, params, nullptr, false);
+	build_format_params(builder, SPA_VIDEO_FORMAT_P010_10LE, params, nullptr, false);
 #endif
 
