+// format is offered twice. The HDR pod carries a FIXED, MANDATORY BT.2020 + SMPTE ST.2084 (PQ)
+// description, because that is exactly what paint_pipewire() encodes into it (the HDR screenshot
+// LUT set — a fixed PQ container, independent of what the focused app renders); MANDATORY means
+// a consumer that does not speak PQ/BT.2020 cannot land on it by accident. The SDR pod names
+// BT.709 primaries and the sRGB-family transfer the SDR composite writes, so a consumer that
+// asks for BT.709 lands here and one that asks for nothing still lands on the HDR pod first.
+static void add_format_color_params(struct spa_pod_builder *builder, spa_video_format format, bool bHDR)
 {
 	if (format == SPA_VIDEO_FORMAT_NV12) {
 		spa_pod_builder_add(builder,
@@ -200,7 +209,7 @@ static void add_format_color_params(struct spa_pod_builder *builder, spa_video_f
 			0);
 	}
 #if GAMESCOPE_PIPEWIRE_HDR
-	else if (is_hdr_video_format(format)) {
+	else if (is_ten_bit_video_format(format) && bHDR) {
 		if (format == SPA_VIDEO_FORMAT_P010_10LE) {
 			// The 4:2:0 container fixes its matrix as well: BT.2020 limited is what the P010
 			// pass writes, so a consumer that wants anything else must not land here.
@@ -214,12 +223,33 @@ static void add_format_color_params(struct spa_pod_builder *builder, spa_video_f
 		spa_pod_builder_prop(builder, SPA_FORMAT_VIDEO_colorPrimaries, SPA_POD_PROP_FLAG_MANDATORY);
 		spa_pod_builder_id(builder, kSpaVideoColorPrimariesBt2020);
 	}
+	else if (is_ten_bit_video_format(format)) {
+		if (format == SPA_VIDEO_FORMAT_P010_10LE) {
+			spa_pod_builder_add(builder,
+				SPA_FORMAT_VIDEO_colorMatrix, SPA_POD_Id(SPA_VIDEO_COLOR_MATRIX_BT709),
+				SPA_FORMAT_VIDEO_colorRange, SPA_POD_CHOICE_ENUM_Id(3,
+								SPA_VIDEO_COLOR_RANGE_16_235,
+								SPA_VIDEO_COLOR_RANGE_16_235,
+								SPA_VIDEO_COLOR_RANGE_0_255),
+				0);
+		}
+		// One curve, three names: the composite encodes sRGB, and consumers call that sRGB,
+		// BT.709 or gamma 2.2 interchangeably.
+		spa_pod_builder_add(builder,
+			SPA_FORMAT_VIDEO_transferFunction, SPA_POD_CHOICE_ENUM_Id(4,
+							SPA_VIDEO_TRANSFER_SRGB,
+							SPA_VIDEO_TRANSFER_SRGB,
+							SPA_VIDEO_TRANSFER_BT709,
+							SPA_VIDEO_TRANSFER_GAMMA22),
+			SPA_FORMAT_VIDEO_colorPrimaries, SPA_POD_Id(SPA_VIDEO_COLOR_PRIMARIES_BT709),
+			0);
+	}
 #endif
 }
 
