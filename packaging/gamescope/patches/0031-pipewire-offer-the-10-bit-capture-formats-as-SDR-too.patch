+// P010 SDR capture: BT.709 limited range on the sRGB codes as the composite stored them, with
+// the 10-bit legal range folded in.
+static constexpr mat3x4 g_rgb2yuv_srgb_to_bt709_limited10 = {{
+  { 0.1821f, 0.6124f, 0.0618f, 0.0626f },
+  { -0.1003f, -0.3376f, 0.4379f, 0.5005f },
+  { 0.4379f, -0.3978f, -0.0402f, 0.5005f },
+}};
+
 static const mat3x4& colorspace_to_conversion_from_srgb_matrix(EStreamColorspace colorspace) {
 	switch (colorspace) {
 		default:
@@ -103,6 +111,19 @@ static const mat3x4& colorspace_to_conversion_from_srgb_matrix(EStreamColorspace
 	}
 }
 
+// The matrix of a 4:2:0 capture pass. P010 takes the composite's codes as stored, never
+// linearised: PQ into BT.2020 for an HDR stream, sRGB into BT.709 for SDR. NV12 linearises
+// through the sRGB view and re-encodes gamma in the shader.
+static const mat3x4& capture_conversion_matrix( const gamescope::Rc<CVulkanTexture>& pYUV ) {
+	if ( !pYUV->isYcbcr10() )
+		return colorspace_to_conversion_from_srgb_matrix( pYUV->streamColorspace() );
+	switch ( pYUV->streamColorspace() ) {
+		case k_EStreamColorspace_BT709:			return g_rgb2yuv_srgb_to_bt709_limited10;
+		case k_EStreamColorspace_BT709_Full:	return g_rgb2yuv_srgb_to_bt709_full;
+		default:								return g_rgb2yuv_pq_to_bt2020_limited;
+	}
+}
