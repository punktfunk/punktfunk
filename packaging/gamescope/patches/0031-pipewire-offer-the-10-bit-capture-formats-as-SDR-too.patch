+				CaptureConvertBlitData_t constants( scale, capture_conversion_matrix( pPipewireTexture ) );
 				constants.halfExtent[0] = pPipewireTexture->width() / 2.0f;
 				constants.halfExtent[1] = pPipewireTexture->height() / 2.0f;
