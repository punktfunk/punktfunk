 	params.push_back((const struct spa_pod *) spa_pod_builder_pop(builder, &obj_frame));
 
 //	for (auto& param : params)
@@ -300,6 +330,11 @@ static std::vector<const struct spa_pod *> build_format_params(struct spa_pod_bu
 	// P010 last: the same PQ/BT.2020 container already subsampled to 4:2:0 for a consumer whose
 	// encoder takes it as is. A consumer that prefers it names it first in its own offer.
 	build_format_params(builder, SPA_VIDEO_FORMAT_P010_10LE, params);
+	// The same three formats as SDR, after the HDR pods: a consumer that names BT.709 fails
