+static std::vector<const struct spa_pod *> build_format_params(struct spa_pod_builder *builder);
+
+// The consumer left several modifiers standing. Settle on ours-first order among them and offer
+// that one pod ahead of the full list; PipeWire renegotiates and param_changed runs again with a
+// plain modifier. Every third round in a row settles on LINEAR, so a consumer that never
+// converges still gets a stream.
+static int s_nFixateRounds = 0;
+
+static void fixate_modifier(struct pipewire_state *state, const struct spa_pod_prop *prop)
+{
+	const spa_video_format format = state->video_info.format;
+
+	uint64_t chosen = DRM_FORMAT_MOD_LINEAR;
+	const struct spa_pod *pod = &prop->value;
+	if (spa_pod_is_choice(pod) && ++s_nFixateRounds < 3) {
+		// Values are the default first, then the alternatives (which repeat it).
+		const uint32_t nValues = SPA_POD_CHOICE_N_VALUES(pod);
+		const uint64_t *pValues = (const uint64_t *) SPA_POD_CHOICE_VALUES(pod);
+		bool bFound = false;
+		for (uint64_t ours : capture_modifiers(format)) {
+			for (uint32_t i = 0; i < nValues && !bFound; i++)
+				bFound = pValues[i] == ours;
+			if (bFound) {
+				chosen = ours;
+				break;
+			}
+		}
+	}
+
+	uint8_t buf[16384];
+	struct spa_pod_builder builder = SPA_POD_BUILDER_INIT(buf, sizeof(buf));
+	std::vector<const struct spa_pod *> params;
+	build_format_params(&builder, format, params, &chosen);
+	const std::vector<const struct spa_pod *> offers = build_format_params(&builder);
+	params.insert(params.end(), offers.begin(), offers.end());
+
+	pwr_log.infof("fixating the dmabuf modifier: 0x%llx", (unsigned long long) chosen);
+	if (pw_stream_update_params(state->stream, params.data(), params.size()) < 0) {
+		pwr_log.errorf("pw_stream_update_params failed");
+	}
+}
