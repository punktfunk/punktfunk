# The one bun release every channel builds with and vendors. Bump every line together from the
# release's SHASUMS256.txt; scripts/ci/check-bun-nix.sh fails any other pin that disagrees.
BUN_VERSION=1.4.4
# bun-linux-x64-baseline.zip
BUN_SHA=e0446eb55995772eb9894bebae9a6be368d985a8b9271ee124486f9946eedd76
# bun-darwin-aarch64.zip, which the macOS host bundle carries (packaging/macos/fetch-bun.sh)
BUN_SHA_DARWIN_AARCH64=c240d7f0ccb90c263a849fcdb09b7ee62630d921348ed6aafda86b9d577bc510
