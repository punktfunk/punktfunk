#version 450
// The 10-bit SDR twin of `rgb2yuv10.comp`: packed RGB -> 10-bit 4:2:0, BT.709 NCL, full or studio
// range by `FULL_RANGE`, for an HEVC Main10 / AV1 10-bit session that stays SDR (10-bit depth, no
// HDR volume). Same store layout and cursor blend as the HDR shader; only the 3x3 matrix differs
// (709 luma weights, not 2020). The source R'G'B' is sRGB, not PQ, so — as in both siblings —
// there is no transfer here.
//
// STORE LAYOUT. Identical to `rgb2yuv10.comp`: scratch `r16`/`rg16` planes get `vkCmdCopyImage`d
// into a `G10X6_...` picture whose texels put the 10-bit value in the HIGH bits of a 16-bit word,
// so a written value `f` lands as `round(f * 65535)` and must equal `code10 << 6` — the `CODE10`
// factor. See that file for what breaks if you drop the `<< 6`.
//
// Rebuild: glslangValidator -V rgb2yuv10_709.comp -o rgb2yuv10_709.spv  (vendored beside this file)
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D rgb;                  // packed RGB input (sampled; 8-bit ok)
layout(binding = 1, r16)  uniform writeonly image2D yImg;   // full-res Y  (10-bit in the high bits)
layout(binding = 2, rg16) uniform writeonly image2D uvImg;  // half-res UV (interleaved)
layout(binding = 3) uniform sampler2D cursorTex;            // straight-alpha RGBA cursor (top-left)
layout(std430, binding = 4) readonly buffer Lin { uint linWords[]; }; // a LINEAR source's bytes

layout(push_constant) uniform Push {
    ivec2 curOrigin;   // top-left of the cursor in frame pixels (position - hotspot)
    ivec2 curSize;     // cursor w,h in pixels; x <= 0 => disabled
    uvec3 lin;         // x != 0: read the source from `linWords`
} pc;

// A LINEAR dmabuf read as words at the producer's own stride (`lin.x` != 0), in place of the
// sampled image: a driver may read a LINEAR image at a row pitch it rounds. `lin` is the
// layout (1 = B,G,R,x bytes, 2 = R,G,B,x bytes, 3 = x:R:G:B 2:10:10:10, 4 = x:B:G:R), the
// first pixel's word and the row stride in words.
vec3 srcTexel(ivec2 p) {
    if (pc.lin.x == 0u) return texelFetch(rgb, p, 0).rgb;
    uint w = linWords[pc.lin.y + uint(p.y) * pc.lin.z + uint(p.x)];
    if (pc.lin.x == 1u) return vec3(float((w >> 16) & 0xFFu), float((w >> 8) & 0xFFu), float(w & 0xFFu)) / 255.0;
    if (pc.lin.x == 2u) return vec3(float(w & 0xFFu), float((w >> 8) & 0xFFu), float((w >> 16) & 0xFFu)) / 255.0;
    if (pc.lin.x == 3u) return vec3(float((w >> 20) & 0x3FFu), float((w >> 10) & 0x3FFu), float(w & 0x3FFu)) / 1023.0;
    return vec3(float(w & 0x3FFu), float((w >> 10) & 0x3FFu), float((w >> 20) & 0x3FFu)) / 1023.0;
}

// 10-bit code value -> the normalized float that stores it in the high bits of a 16-bit texel.
const float CODE10 = 64.0 / 65535.0;

// The session's range, a pipeline specialization constant: full (the default, whose arithmetic
// is unchanged) or studio (Y 64..940, CbCr 64..960).
layout(constant_id = 0) const bool FULL_RANGE = true;

// BT.709 non-constant-luminance in 10-bit code values. Full range, then studio:
//   Y' = 1023*(0.2126R + 0.7152G + 0.0722B)    Y' = 64 + 876*(...)
//   Cb = 512 + 1023*(B' - Y')/1.8556            Cb = 512 + 896*(B' - Y')/1.8556
//   Cr = 512 + 1023*(R' - Y')/1.5748            Cr = 512 + 896*(R' - Y')/1.5748
float lumaY(vec3 c) {
    if (!FULL_RANGE) return 64.0 + 186.2376*c.r + 626.5152*c.g + 63.2472*c.b;
    return 217.4898*c.r + 731.6496*c.g + 73.8606*c.b;
}

// Blend the cursor over `col` at frame pixel `p`, when `p` falls inside the cursor rectangle.
vec3 withCursor(ivec2 p, vec3 col) {
    if (pc.curSize.x <= 0) return col;
    ivec2 cp = p - pc.curOrigin;
    if (cp.x < 0 || cp.y < 0 || cp.x >= pc.curSize.x || cp.y >= pc.curSize.y) return col;
    vec4 c = texelFetch(cursorTex, cp, 0);
    return mix(col, c.rgb, c.a);
}

// Source may be SMALLER than the coded (16-aligned) Y plane — clamp every fetch to the source edge
// so alignment-padding rows duplicate the last real row (see the SDR/HDR siblings).
void main() {
    ivec2 sz = imageSize(yImg);
    ivec2 rmax = textureSize(rgb, 0) - 1;
    ivec2 uvc = ivec2(gl_GlobalInvocationID.xy);
    ivec2 p = uvc * 2;
    if (p.x >= sz.x || p.y >= sz.y) return;
    vec3 c00 = withCursor(p,               srcTexel(min(p,               rmax)));
    vec3 c10 = withCursor(p + ivec2(1, 0), srcTexel(min(p + ivec2(1, 0), rmax)));
    vec3 c01 = withCursor(p + ivec2(0, 1), srcTexel(min(p + ivec2(0, 1), rmax)));
    vec3 c11 = withCursor(p + ivec2(1, 1), srcTexel(min(p + ivec2(1, 1), rmax)));
    imageStore(yImg, p,               vec4(lumaY(c00) * CODE10, 0, 0, 1));
    imageStore(yImg, p + ivec2(1, 0), vec4(lumaY(c10) * CODE10, 0, 0, 1));
    imageStore(yImg, p + ivec2(0, 1), vec4(lumaY(c01) * CODE10, 0, 0, 1));
    imageStore(yImg, p + ivec2(1, 1), vec4(lumaY(c11) * CODE10, 0, 0, 1));
    // Left-sited chroma (H.273 type 0, what decoders assume): [1 2 1] over columns p.x-1..p.x+1.
    ivec2 pl = max(p + ivec2(-1, 0), ivec2(0));
    vec3 cl0 = withCursor(pl,               srcTexel(min(pl,               rmax)));
    vec3 cl1 = withCursor(pl + ivec2(0, 1), srcTexel(min(pl + ivec2(0, 1), rmax)));
    vec3 a = (cl0 + 2.0 * c00 + c10 + cl1 + 2.0 * c01 + c11) * 0.125;
    float U, V;
    if (!FULL_RANGE) {
        U = 512.0 - 102.6564*a.r - 345.3436*a.g + 448.0000*a.b;
        V = 512.0 + 448.0000*a.r - 406.9210*a.g -  41.0790*a.b;
    } else {
        U = 512.0 - 117.2073*a.r - 394.2928*a.g + 511.5000*a.b;
        V = 512.0 + 511.5000*a.r - 464.5984*a.g -  46.9016*a.b;
    }
    imageStore(uvImg, uvc, vec4(U * CODE10, V * CODE10, 0, 1));
}
