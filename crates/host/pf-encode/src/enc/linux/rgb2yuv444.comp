#version 450
// RGB(A) -> full-res Y + FULL-res interleaved CbCr (BT.709 full range): the 4:4:4 twin of
// rgb2yuv.comp — one invocation per pixel, no chroma box filter, no siting. Same coefficients
// byte-for-byte (the wavelet clients' planar CSC decodes both layouts identically), same
// cursor-as-metadata blend, same source-edge clamp for the 32-aligned coded extent.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D rgb;                  // packed RGB input (sampled; BGRA import ok)
layout(binding = 1, r8)  uniform writeonly image2D yImg;    // full-res Y
layout(binding = 2, rg8) uniform writeonly image2D uvImg;   // full-res UV (interleaved)
layout(binding = 3) uniform sampler2D cursorTex;            // straight-alpha RGBA cursor (top-left)
layout(std430, binding = 4) readonly buffer Lin { uint linWords[]; }; // a LINEAR source's bytes

layout(push_constant) uniform Push {
    ivec2 curOrigin;   // top-left of the cursor in frame pixels (position - hotspot)
    ivec2 curSize;     // cursor w,h in pixels; x <= 0 => disabled
    uvec3 lin;         // x != 0: read the source from `linWords`
} pc;

// A LINEAR dmabuf read as words at the producer's own stride (`lin.x` != 0), in place of the
// sampled image: a driver may read a LINEAR image at a row pitch it rounds. `lin` is the
// layout (1 = B,G,R,x bytes, 2 = R,G,B,x bytes, 3 = x:R:G:B 2:10:10:10, 4 = x:B:G:R), the
// first pixel's word and the row stride in words.
vec3 srcTexel(ivec2 p) {
    if (pc.lin.x == 0u) return texelFetch(rgb, p, 0).rgb;
    uint w = linWords[pc.lin.y + uint(p.y) * pc.lin.z + uint(p.x)];
    if (pc.lin.x == 1u) return vec3(float((w >> 16) & 0xFFu), float((w >> 8) & 0xFFu), float(w & 0xFFu)) / 255.0;
    if (pc.lin.x == 2u) return vec3(float(w & 0xFFu), float((w >> 8) & 0xFFu), float((w >> 16) & 0xFFu)) / 255.0;
    if (pc.lin.x == 3u) return vec3(float((w >> 20) & 0x3FFu), float((w >> 10) & 0x3FFu), float(w & 0x3FFu)) / 1023.0;
    return vec3(float(w & 0x3FFu), float((w >> 10) & 0x3FFu), float((w >> 20) & 0x3FFu)) / 1023.0;
}

float lumaY(vec3 c) { return 0.2126*c.r + 0.7152*c.g + 0.0722*c.b; }

vec3 withCursor(ivec2 p, vec3 col) {
    if (pc.curSize.x <= 0) return col;
    ivec2 cp = p - pc.curOrigin;
    if (cp.x < 0 || cp.y < 0 || cp.x >= pc.curSize.x || cp.y >= pc.curSize.y) return col;
    vec4 c = texelFetch(cursorTex, cp, 0);
    return mix(col, c.rgb, c.a);
}

void main() {
    ivec2 sz = imageSize(yImg);
    ivec2 rmax = textureSize(rgb, 0) - 1;
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= sz.x || p.y >= sz.y) return;
    vec3 c = withCursor(p, srcTexel(min(p, rmax)));
    imageStore(yImg, p, vec4(lumaY(c), 0, 0, 1));
    float U = 128.0/255.0 - 0.1146*c.r - 0.3854*c.g + 0.5000*c.b;
    float V = 128.0/255.0 + 0.5000*c.r - 0.4542*c.g - 0.0458*c.b;
    imageStore(uvImg, p, vec4(U, V, 0, 1));
}
