#version 450
// RGB(A) -> full-res Y + FULL-res interleaved CbCr, 10-bit BT.2020 NCL full range: the
// 4:4:4 twin of `rgb2yuv10.comp` — one invocation per pixel, no chroma box filter, no siting.
// Same coefficients and store layout (the wavelet clients' planar CSC decodes both layouts
// identically), same cursor-as-metadata blend, same source-edge clamp for the coded extent.
//
// The source samples are ALREADY PQ-encoded BT.2020 R'G'B' (gamescope composites into the PQ
// container; see packaging/gamescope), so this is a pure 3x3 matrix on the code values — there
// is no transfer function to apply here, and applying one would be wrong.
//
// STORE LAYOUT. `r16`/`rg16` planes carry the 10-bit value in the HIGH bits (`code10 << 6`,
// the P010-style layout pyrowave's encoder contract wants) — the `CODE10` factor below. See
// `rgb2yuv10.comp` for what breaks if you drop the `<< 6`.
//
// Rebuild: glslangValidator -V rgb2yuv444_10.comp -o rgb2yuv444_10.spv (vendored beside this file)
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D rgb;                  // packed 2:10:10:10 input (sampled)
layout(binding = 1, r16)  uniform writeonly image2D yImg;   // full-res Y  (10-bit in the high bits)
layout(binding = 2, rg16) uniform writeonly image2D uvImg;  // full-res UV (interleaved)
layout(binding = 3) uniform sampler2D cursorTex;            // straight-alpha RGBA cursor (top-left)
layout(std430, binding = 4) readonly buffer Lin { uint linWords[]; }; // a LINEAR source's bytes

layout(push_constant) uniform Push {
    ivec2 curOrigin;   // top-left of the cursor in frame pixels (position - hotspot)
    ivec2 curSize;     // cursor w,h in pixels; x <= 0 => disabled
    uvec3 lin;         // x != 0: read the source from `linWords`
} pc;

// A LINEAR dmabuf read as words at the producer's own stride (`lin.x` != 0), in place of the
// sampled image: a driver may read a LINEAR image at a row pitch it rounds. `lin` is the
// layout (1 = B,G,R,x bytes, 2 = R,G,B,x bytes, 3 = x:R:G:B 2:10:10:10, 4 = x:B:G:R), the
// first pixel's word and the row stride in words.
vec3 srcTexel(ivec2 p) {
    if (pc.lin.x == 0u) return texelFetch(rgb, p, 0).rgb;
    uint w = linWords[pc.lin.y + uint(p.y) * pc.lin.z + uint(p.x)];
    if (pc.lin.x == 1u) return vec3(float((w >> 16) & 0xFFu), float((w >> 8) & 0xFFu), float(w & 0xFFu)) / 255.0;
    if (pc.lin.x == 2u) return vec3(float(w & 0xFFu), float((w >> 8) & 0xFFu), float((w >> 16) & 0xFFu)) / 255.0;
    if (pc.lin.x == 3u) return vec3(float((w >> 20) & 0x3FFu), float((w >> 10) & 0x3FFu), float(w & 0x3FFu)) / 1023.0;
    return vec3(float(w & 0x3FFu), float((w >> 10) & 0x3FFu), float((w >> 20) & 0x3FFu)) / 1023.0;
}

// 10-bit code value -> the normalized float that stores it in the high bits of a 16-bit texel.
const float CODE10 = 64.0 / 65535.0;

// BT.2020 non-constant-luminance, full range, expressed directly in 10-bit code values:
//   Y' = 1023*(0.2627R + 0.6780G + 0.0593B)
//   Cb = 512 + 1023*(B' - Y')/1.8814
//   Cr = 512 + 1023*(R' - Y')/1.4746
float lumaY(vec3 c) { return 268.7421*c.r + 693.5940*c.g + 60.6639*c.b; }

// Blend the cursor over `col` at frame pixel `p`, when `p` falls inside the cursor rectangle.
// The host uploads the cursor PQ-encoded (`CursorOverlay::pq_rgba`), so this mixes PQ codes.
vec3 withCursor(ivec2 p, vec3 col) {
    if (pc.curSize.x <= 0) return col;
    ivec2 cp = p - pc.curOrigin;
    if (cp.x < 0 || cp.y < 0 || cp.x >= pc.curSize.x || cp.y >= pc.curSize.y) return col;
    vec4 c = texelFetch(cursorTex, cp, 0);
    return mix(col, c.rgb, c.a);
}

// Source may be SMALLER than the coded (16-aligned) Y plane — clamp every fetch to the source
// edge so the alignment-padding rows duplicate the last real row (see the 4:2:0 siblings).
void main() {
    ivec2 sz = imageSize(yImg);
    ivec2 rmax = textureSize(rgb, 0) - 1;
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= sz.x || p.y >= sz.y) return;
    vec3 c = withCursor(p, srcTexel(min(p, rmax)));
    imageStore(yImg, p, vec4(lumaY(c) * CODE10, 0, 0, 1));
    float U = 512.0 - 142.8415*c.r - 368.6584*c.g + 511.5000*c.b;
    float V = 512.0 + 511.5000*c.r - 470.3603*c.g -  41.1392*c.b;
    imageStore(uvImg, p, vec4(U * CODE10, V * CODE10, 0, 1));
}
