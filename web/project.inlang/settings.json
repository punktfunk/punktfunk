{
	"$schema": "https://inlang.com/schema/project-settings",
	"baseLocale": "en",
	"locales": ["en", "de", "es", "fr", "it", "pt-BR"],
	"modules": ["./node_modules/@inlang/plugin-message-format/dist/index.js"],
	"plugin.inlang.messageFormat": {
		"pathPattern": [
			"../l10n/messages/web/{locale}.json",
			"../l10n/messages/common/{locale}.json",
			"../l10n/messages/host/{locale}.json"
		]
	}
}
