{
	"name": "punktfunk-web",
	"private": true,
	"type": "module",
	"description": "punktfunk management console — TanStack Start + React Query (orval) + @unom/ui + Paraglide i18n",
	"scripts": {
		"prepare": "bun run codegen",
		"postinstall": "bun2nix -o bun.nix",
		"codegen": "bun x --bun orval --config orval.config.ts && paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && node tools/check-i18n.mjs",
		"predev": "bun x --bun orval --config orval.config.ts",
		"dev": "vite dev --port 47992",
		"prebuild": "bun x --bun orval --config orval.config.ts",
		"build": "vite build",
		"postbuild": "node tools/check-i18n.mjs && node tools/check-omarchy-palette.mjs",
		"start": "bun run .output/server/index.mjs",
		"api:gen": "bun x --bun orval --config orval.config.ts",
		"lint": "tsc --noEmit",
		"check": "biome check .",
		"test": "bun test server/ nitro-entry/ src/",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"screenshots": "node tools/screenshots.mjs",
		"screenshots:build": "bun run build-storybook && node tools/screenshots.mjs"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@tanstack/react-query": "^5.104.1",
		"@tanstack/react-router": "^1.170.41",
		"@tanstack/react-start": "^1.168.60",
		"@unom/style": "^0.4.4",
		"@unom/ui": "^0.10.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.52.0",
		"motion": "^14.0.0",
		"next": "^16.4.0",
		"radix-ui": "^1.7.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"recharts": "^3.10.1",
		"tailwind-merge": "^3.7.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@inlang/paraglide-js": "^2.26.0",
		"@inlang/plugin-message-format": "^4.4.5",
		"@storybook/react-vite": "^10.6.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/nitro-v2-vite-plugin": "^1.155.2",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"bun2nix": "2.1.2",
		"effect": "4.0.1",
		"orval": "^8.40.0",
		"playwright": "^1.63.0",
		"storybook": "^10.6.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.3",
		"vite-tsconfig-paths": "^6.1.1"
	},
	"overrides": {
		"dompurify": "^3.4.16",
		"undici": "^7.30.0"
	}
}
