        {"at_ms": 90, "ev": "decoded", "flags": ["anchor"], "evidence": "damaged", "want": {}},
        {"at_ms": 100, "ev": "decoded", "evidence": "damaged", "want": {"hold": true, "ask": "keyframe"}}
