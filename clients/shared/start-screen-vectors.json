{
  "$comment": "Cross-language contract for the start-screen policy (design/default-host.md §3). The Rust (crates/client/pf-client-core/src/start.rs), Swift (PunktfunkShared/StartScreen.swift) and Kotlin (kit/link/StartScreen.kt) resolvers each run every case in their own suite, so the three cannot drift into three different landings. A host is reduced to the three things the policy reads: its stable id, whether it is paired, and whether it holds a pin — each store spells the pin differently (hex string, Data, base64), the policy only asks whether there is one. `host_index` is absent when there is no default host.",
  "version": 1,
  "cases": [
    {
      "name": "no-hosts-lands-on-the-list",
      "start_in": "library",
      "hosts": [],
      "expect": { "start": "hosts", "source": "none" }
    },
    {
      "name": "one-unpaired-host-is-not-a-default",
      "start_in": "library",
      "hosts": [{ "name": "Desk", "id": "a", "paired": false, "pinned": true }],
      "expect": { "start": "hosts", "source": "none" }
    },
    {
      "name": "one-paired-host-is-the-derived-default",
      "start_in": "library",
      "hosts": [{ "name": "Desk", "id": "a", "paired": true, "pinned": true }],
      "expect": { "start": "library", "host_index": 0, "source": "derived" }
    },
    {
      "name": "a-paired-host-without-a-pin-is-not-a-default",
      "start_in": "library",
      "hosts": [{ "name": "Desk", "id": "a", "paired": true, "pinned": false }],
      "expect": { "start": "hosts", "source": "none" }
    },
    {
      "name": "two-paired-hosts-and-no-choice-land-on-the-list",
      "start_in": "library",
      "hosts": [
        { "name": "Desk", "id": "a", "paired": true, "pinned": true },
        { "name": "Couch", "id": "b", "paired": true, "pinned": true }
      ],
      "expect": { "start": "hosts", "source": "none" }
    },
    {
      "name": "two-paired-hosts-with-an-explicit-id",
      "start_in": "library",
      "default_host": "b",
      "hosts": [
        { "name": "Desk", "id": "a", "paired": true, "pinned": true },
        { "name": "Couch", "id": "b", "paired": true, "pinned": true }
      ],
      "expect": { "start": "library", "host_index": 1, "source": "explicit" }
    },
    {
      "name": "a-dangling-id-falls-through-to-the-derived-rule",
      "start_in": "library",
      "default_host": "gone",
      "hosts": [{ "name": "Desk", "id": "a", "paired": true, "pinned": true }],
      "expect": { "start": "library", "host_index": 0, "source": "derived" }
    },
    {
      "name": "a-dangling-id-with-two-paired-hosts-is-no-default",
      "start_in": "library",
      "default_host": "gone",
      "hosts": [
        { "name": "Desk", "id": "a", "paired": true, "pinned": true },
        { "name": "Couch", "id": "b", "paired": true, "pinned": true }
      ],
      "expect": { "start": "hosts", "source": "none" }
    },
    {
      "name": "an-id-naming-an-unpaired-record-loses-to-the-derived-rule",
      "start_in": "library",
      "default_host": "a",
      "hosts": [
        { "name": "Desk", "id": "a", "paired": false, "pinned": true },
        { "name": "Couch", "id": "b", "paired": true, "pinned": true }
      ],
      "expect": { "start": "library", "host_index": 1, "source": "derived" }
    },
    {
      "name": "an-unknown-start-in-reads-as-the-host-list",
      "start_in": "shelf",
      "hosts": [{ "name": "Desk", "id": "a", "paired": true, "pinned": true }],
      "expect": { "start": "hosts", "host_index": 0, "source": "derived" }
    },
    {
      "name": "an-empty-start-in-reads-as-the-host-list",
      "start_in": "",
      "hosts": [{ "name": "Desk", "id": "a", "paired": true, "pinned": true }],
      "expect": { "start": "hosts", "host_index": 0, "source": "derived" }
    },
    {
      "name": "stream-with-no-default-lands-on-the-list",
      "start_in": "stream",
      "hosts": [{ "name": "Desk", "id": "a", "paired": false, "pinned": true }],
      "expect": { "start": "hosts", "source": "none" }
    },
    {
      "name": "stream-with-a-default-streams",
      "start_in": "stream",
      "hosts": [{ "name": "Desk", "id": "a", "paired": true, "pinned": true }],
      "expect": { "start": "stream", "host_index": 0, "source": "derived" }
    },
    {
      "name": "hosts-keeps-the-list-even-with-a-default",
      "start_in": "hosts",
      "default_host": "a",
      "hosts": [{ "name": "Desk", "id": "a", "paired": true, "pinned": true }],
      "expect": { "start": "hosts", "host_index": 0, "source": "explicit" }
    },
    {
      "name": "an-empty-default-host-string-is-no-pointer",
      "start_in": "library",
      "default_host": "",
      "hosts": [
        { "name": "Desk", "id": "a", "paired": true, "pinned": true },
        { "name": "Couch", "id": "b", "paired": true, "pinned": true }
      ],
      "expect": { "start": "hosts", "source": "none" }
    }
  ]
}
