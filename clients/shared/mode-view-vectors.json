{
  "$comment": "Mode-and-view ask rule, rules 1-4 of design/stream-geometry-overhaul.md §6, read by the host's native::stream::rebuild mode_view_vectors test. A session runs `live` (mode [w, h, hz], view [w, h] or null) on a display of its `tenure`: own, shared (its own, another session joined it), joiner-held or joiner-alone. The control task holds `hold` and is asked `ask` for `codec`. `build` is refused (the control task hands nothing on), none, encoder (the encoder alone, on the live display) or display (a new display mode). `kept` is the mode and view the session runs after; `told` is the last mode, encoded picture and correction the stream tells, null when it tells nothing. `only` names the one host OS a row holds on. `verdict` is wanted, or the decision that settles what the row pins today.",
  "rows": [
    {"name": "a view inside the mode, smaller on both axes, is kept", "rule": 1,
     "live": {"mode": [1920, 1080, 60], "view": null}, "tenure": "own",
     "hold": {"mode": [1920, 1080, 60], "view": null},
     "ask": {"mode": [1920, 1080, 60], "view": [1280, 720]}, "codec": "hevc",
     "build": "encoder", "kept": {"mode": [1920, 1080, 60], "view": [1280, 720]},
     "told": {"mode": [1920, 1080, 60], "picture": [1280, 720], "corrects": false},
     "verdict": "wanted"},
    {"name": "a view smaller on one axis is kept, the mode fitted inside it", "rule": 1,
     "live": {"mode": [1920, 1080, 60], "view": null}, "tenure": "own",
     "hold": {"mode": [1920, 1080, 60], "view": null},
     "ask": {"mode": [1920, 1080, 60], "view": [1920, 720]}, "codec": "hevc",
     "build": "encoder", "kept": {"mode": [1920, 1080, 60], "view": [1920, 720]},
     "told": {"mode": [1920, 1080, 60], "picture": [1280, 720], "corrects": false},
     "verdict": "wanted"},
    {"name": "a mode-sized view is no view", "rule": 1,
     "live": {"mode": [1920, 1080, 60], "view": null}, "tenure": "own",
     "hold": {"mode": [1920, 1080, 60], "view": null},
     "ask": {"mode": [1920, 1080, 60], "view": [1920, 1080]}, "codec": "hevc",
     "build": "none", "kept": {"mode": [1920, 1080, 60], "view": null},
     "told": {"mode": [1920, 1080, 60], "picture": [1920, 1080], "corrects": false},
     "verdict": "wanted"},
    {"name": "a view larger than the mode is no view", "rule": 1,
     "live": {"mode": [1920, 1080, 60], "view": null}, "tenure": "own",
     "hold": {"mode": [1920, 1080, 60], "view": null},
     "ask": {"mode": [1920, 1080, 60], "view": [2560, 1440]}, "codec": "hevc",
     "build": "none", "kept": {"mode": [1920, 1080, 60], "view": null},
     "told": {"mode": [1920, 1080, 60], "picture": [1920, 1080], "corrects": false},
     "verdict": "wanted"},
    {"name": "an odd view is no view", "rule": 1,
     "live": {"mode": [1920, 1080, 60], "view": null}, "tenure": "own",
     "hold": {"mode": [1920, 1080, 60], "view": null},
     "ask": {"mode": [1920, 1080, 60], "view": [1367, 768]}, "codec": "hevc",
     "build": "none", "kept": {"mode": [1920, 1080, 60], "view": null},
     "told": {"mode": [1920, 1080, 60], "picture": [1920, 1080], "corrects": false},
     "verdict": "wanted"},
    {"name": "PyroWave: a view under the codec's floor is no view", "rule": 1,
     "live": {"mode": [1920, 1080, 60], "view": null}, "tenure": "own",
     "hold": {"mode": [1920, 1080, 60], "view": null},
     "ask": {"mode": [1920, 1080, 60], "view": [120, 100]}, "codec": "pyrowave",
     "build": "none", "kept": {"mode": [1920, 1080, 60], "view": null},
     "told": {"mode": [1920, 1080, 60], "picture": [1920, 1080], "corrects": false},
     "verdict": "wanted"},
    {"name": "the size in force at another rate, no view: the view in force stays", "rule": 2,
     "live": {"mode": [1920, 1080, 60], "view": [1280, 720]}, "tenure": "own",
     "hold": {"mode": [1920, 1080, 60], "view": [1280, 720]},
     "ask": {"mode": [1920, 1080, 120], "view": null}, "codec": "hevc",
     "build": "display", "kept": {"mode": [1920, 1080, 120], "view": [1280, 720]},
     "told": {"mode": [1920, 1080, 120], "picture": [1280, 720], "corrects": false},
     "verdict": "wanted"},
    {"name": "the mode in force again, no view: nothing changes", "rule": 2,
     "live": {"mode": [1920, 1080, 60], "view": [1280, 720]}, "tenure": "own",
     "hold": {"mode": [1920, 1080, 60], "view": [1280, 720]},
     "ask": {"mode": [1920, 1080, 60], "view": null}, "codec": "hevc",
     "build": "none", "kept": {"mode": [1920, 1080, 60], "view": [1280, 720]},
     "told": {"mode": [1920, 1080, 60], "picture": [1280, 720], "corrects": false},
     "verdict": "wanted"},
    {"name": "a mode-sized view clears the view in force", "rule": 2,
     "live": {"mode": [1920, 1080, 60], "view": [1280, 720]}, "tenure": "own",
     "hold": {"mode": [1920, 1080, 60], "view": [1280, 720]},
     "ask": {"mode": [1920, 1080, 60], "view": [1920, 1080]}, "codec": "hevc",
     "build": "encoder", "kept": {"mode": [1920, 1080, 60], "view": null},
     "told": {"mode": [1920, 1080, 60], "picture": [1920, 1080], "corrects": false},
     "verdict": "wanted"},
    {"name": "another size with no view clears the view in force", "rule": 2,
     "live": {"mode": [1920, 1080, 60], "view": [1280, 720]}, "tenure": "own",
     "hold": {"mode": [1920, 1080, 60], "view": [1280, 720]},
     "ask": {"mode": [2560, 1440, 60], "view": null}, "codec": "hevc",
     "build": "display", "kept": {"mode": [2560, 1440, 60], "view": null},
     "told": {"mode": [2560, 1440, 60], "picture": [2560, 1440], "corrects": false},
     "verdict": "wanted"},
    {"name": "shared: a smaller size is framed on the mode, the client corrected", "rule": 3,
     "live": {"mode": [1920, 1080, 60], "view": null}, "tenure": "shared",
     "hold": {"mode": [1920, 1080, 60], "view": null},
     "ask": {"mode": [1280, 720, 60], "view": null}, "codec": "hevc",
     "build": "encoder", "kept": {"mode": [1920, 1080, 60], "view": [1280, 720]},
     "told": {"mode": [1920, 1080, 60], "picture": [1280, 720], "corrects": true},
     "verdict": "wanted"},
    {"name": "shared: a larger size changes nothing, the client corrected", "rule": 3,
     "live": {"mode": [1920, 1080, 60], "view": null}, "tenure": "shared",
     "hold": {"mode": [1920, 1080, 60], "view": null},
     "ask": {"mode": [2560, 1440, 60], "view": null}, "codec": "hevc",
     "build": "none", "kept": {"mode": [1920, 1080, 60], "view": null},
     "told": {"mode": [1920, 1080, 60], "picture": [1920, 1080], "corrects": true},
     "verdict": "wanted"},
    {"name": "shared, framed: the framed size at another rate changes nothing", "rule": 3,
     "live": {"mode": [1920, 1080, 60], "view": [1280, 720]}, "tenure": "shared",
     "hold": {"mode": [1920, 1080, 60], "view": null},
     "ask": {"mode": [1280, 720, 120], "view": null}, "codec": "hevc",
     "build": "none", "kept": {"mode": [1920, 1080, 60], "view": [1280, 720]},
     "told": {"mode": [1920, 1080, 60], "picture": [1280, 720], "corrects": true},
     "verdict": "wanted"},
    {"name": "shared, framed: the told size at another rate keeps the told view", "rule": 3,
     "live": {"mode": [1920, 1080, 60], "view": [1280, 720]}, "tenure": "shared",
     "hold": {"mode": [1920, 1080, 60], "view": [1280, 720]},
     "ask": {"mode": [1920, 1080, 120], "view": null}, "codec": "hevc",
     "build": "none", "kept": {"mode": [1920, 1080, 60], "view": [1280, 720]},
     "told": {"mode": [1920, 1080, 60], "picture": [1280, 720], "corrects": true},
     "verdict": "wanted"},
    {"name": "a joiner held by another session is refused", "rule": 4,
     "live": {"mode": [1920, 1080, 60], "view": null}, "tenure": "joiner-held",
     "hold": {"mode": [1920, 1080, 60], "view": null},
     "ask": {"mode": [2560, 1440, 60], "view": null}, "codec": "hevc",
     "build": "refused", "kept": {"mode": [1920, 1080, 60], "view": null},
     "told": null, "verdict": "wanted"},
    {"name": "a joiner alone builds a display of its own", "rule": 4, "only": "linux",
     "live": {"mode": [1920, 1080, 60], "view": null}, "tenure": "joiner-alone",
     "hold": {"mode": [1920, 1080, 60], "view": null},
     "ask": {"mode": [2560, 1440, 60], "view": null}, "codec": "hevc",
     "build": "display", "kept": {"mode": [2560, 1440, 60], "view": null},
     "told": {"mode": [2560, 1440, 60], "picture": [2560, 1440], "corrects": false},
     "verdict": "wanted"},
    {"name": "a joiner alone is held off Linux", "rule": 4, "only": "windows",
     "live": {"mode": [1920, 1080, 60], "view": null}, "tenure": "joiner-alone",
     "hold": {"mode": [1920, 1080, 60], "view": null},
     "ask": {"mode": [2560, 1440, 60], "view": null}, "codec": "hevc",
