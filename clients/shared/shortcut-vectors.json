  "validate": {
    "$comment": "Whether candidate may join bindings. expect is ok, identical, press_subset (index = the existing binding it meets), single_press, no_modifier or no_key. A key needs ctrl, alt or shift unless it is f1-f24. Bindings and candidate use the blob's binding shape.",
    "cases": [
      {
        "name": "a press that a hold starts is allowed",
        "bindings": [{"on": "pad", "keys": ["select"], "hold": true, "do": "guide"}],
        "candidate": {"on": "pad", "keys": ["select", "a"], "hold": false, "do": "ring"},
        "expect": "ok"
      },
      {
        "name": "the same buttons as a press and a hold are two-stage",
        "bindings": [{"on": "pad", "keys": ["lb", "rb", "start", "select"], "hold": true, "do": "end_stream"}],
        "candidate": {"on": "pad", "keys": ["lb", "rb", "start", "select"], "hold": false, "do": "release_input"},
        "expect": "ok"
      },
      {
        "name": "a press inside the new chord would fire first",
        "bindings": [{"on": "pad", "keys": ["select", "a"], "hold": false, "do": "ring"}],
        "candidate": {"on": "pad", "keys": ["select", "a", "b"], "hold": false, "do": "stats"},
        "expect": "press_subset", "index": 0
      },
      {
        "name": "a new press inside a hold's chord would fire first",
        "bindings": [
          {"on": "pad", "keys": ["start"], "hold": true, "do": "ring"},
          {"on": "pad", "keys": ["select", "a", "b"], "hold": true, "do": "stats"}
        ],
        "candidate": {"on": "pad", "keys": ["select", "a"], "hold": false, "do": "mic"},
        "expect": "press_subset", "index": 1
      },
      {
        "name": "a hold inside a press's chord is allowed",
        "bindings": [{"on": "pad", "keys": ["select", "a"], "hold": false, "do": "ring"}],
        "candidate": {"on": "pad", "keys": ["select"], "hold": true, "do": "guide"},
        "expect": "ok"
      },
      {
        "name": "the same trigger twice offers a replace",
        "bindings": [
          {"on": "pad", "keys": ["select", "x"], "hold": false, "do": "stats"},
          {"on": "pad", "keys": ["start"], "hold": true, "do": "ring"}
        ],
        "candidate": {"on": "pad", "keys": ["start"], "hold": true, "do": "pad_mouse"},
        "expect": "identical", "index": 1
      },
      {
        "name": "the same buttons in another order are the same trigger",
        "bindings": [{"on": "pad", "keys": ["select", "a"], "hold": false, "do": "ring"}],
        "candidate": {"on": "pad", "keys": ["a", "select"], "hold": false, "do": "stats"},
        "expect": "identical", "index": 0
      },
      {
        "name": "one button is only a hold",
        "bindings": [],
        "candidate": {"on": "pad", "keys": ["start"], "hold": false, "do": "ring"},
        "expect": "single_press"
      },
      {
        "name": "a key needs a modifier",
        "bindings": [],
        "candidate": {"on": "key", "keys": ["o"], "do": "ring"},
        "expect": "no_modifier"
      },
      {
        "name": "a function key needs no modifier",
        "bindings": [{"on": "key", "keys": ["alt", "enter"], "do": "fullscreen"}],
        "candidate": {"on": "key", "keys": ["f11"], "do": "fullscreen"},
        "expect": "ok"
      },
      {
        "name": "F24 is a function key too",
        "bindings": [],
        "candidate": {"on": "key", "keys": ["f24"], "do": "stats"},
        "expect": "ok"
      },
      {
        "name": "modifiers alone are not a key",
        "bindings": [],
        "candidate": {"on": "key", "keys": ["ctrl", "alt"], "do": "ring"},
        "expect": "no_key"
      },
      {
        "name": "the same key combination twice offers a replace",
        "bindings": [{"on": "key", "keys": ["ctrl", "alt", "shift", "o"], "do": "ring"}],
        "candidate": {"on": "key", "keys": ["shift", "alt", "ctrl", "o"], "do": "stats"},
        "expect": "identical", "index": 0
      },
      {
        "name": "fewer modifiers on the same key are another shortcut",
        "bindings": [{"on": "key", "keys": ["ctrl", "alt", "shift", "o"], "do": "ring"}],
        "candidate": {"on": "key", "keys": ["ctrl", "alt", "o"], "do": "stats"},
        "expect": "ok"
      },
      {
        "name": "a pad and a key never meet",
        "bindings": [{"on": "key", "keys": ["ctrl", "a"], "do": "ring"}],
