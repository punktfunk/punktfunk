<?xml version="1.0" encoding="utf-8"?>
<!-- Key filtering only: no accessibility events, no window content. The service requests the
     filter at runtime, while a stream holds the window (KeyCaptureService.filterKeys). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/android_keycapture_service_description"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRequestFilterKeyEvents="true"
    android:isAccessibilityTool="false"
    android:notificationTimeout="100" />
