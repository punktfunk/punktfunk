diff -ruN a/build_support/platform/tvos.rs b/build_support/platform/tvos.rs
--- a/build_support/platform/tvos.rs
+++ b/build_support/platform/tvos.rs
@@ -0,0 +1,80 @@
+//! tvOS: Skia's gn already knows `target_os = "tvos"` (`is_ios` covers it and picks the
+//! `appletvos` / `appletvsimulator` SDK); this only hands it the target and the SDK.
+
+use std::{
+    path::PathBuf,
+    process::{Command, Stdio},
+};
+
+use super::prelude::*;
+
+pub struct Tvos;
+
+/// Matches `TVOS_DEPLOYMENT_TARGET` in the consumer's build.
+const MIN_TVOS_VERSION: &str = "17.0";
+
+impl PlatformDetails for Tvos {
+    fn uses_freetype(&self) -> bool {
+        false
+    }
+
+    fn gn_args(&self, config: &BuildConfiguration, builder: &mut GnArgsBuilder) {
+        let simulator = is_simulator(config.target.abi.as_deref());
+        builder.target_os_and_default_cpu("tvos");
+        if simulator {
+            builder.arg("ios_use_simulator", yes());
+        }
+        builder.target(clang_target(simulator));
+    }
+
+    fn bindgen_args(&self, target: &Target, builder: &mut BindgenArgsBuilder) {
+        let simulator = is_simulator(target.abi.as_deref());
+        builder.args([
+            "-isysroot".to_string(),
+            sdk_path(simulator).to_str().unwrap().to_string(),
+        ]);
+        builder.override_target(&clang_target(simulator));
+    }
+
+    fn link_libraries(&self, features: &Features) -> Vec<String> {
+        let mut libs = vec![
+            "c++",
+            "framework=CoreFoundation",
+            "framework=CoreGraphics",
+            "framework=CoreText",
+            "framework=ImageIO",
+            "framework=MobileCoreServices",
+            "framework=UIKit",
+        ];
+        if features[feature::METAL] {
+            // The Metal backend calls Foundation (NSString, NSError).
+            libs.push("framework=Foundation");
+            libs.push("framework=Metal");
+        }
+        libs.iter().map(|s| s.to_string()).collect()
+    }
+}
+
+fn is_simulator(abi: Option<&str>) -> bool {
+    abi == Some("sim")
+}
+
+fn clang_target(simulator: bool) -> String {
+    let suffix = if simulator { "-simulator" } else { "" };
+    format!("arm64-apple-tvos{MIN_TVOS_VERSION}{suffix}")
+}
+
+fn sdk_path(simulator: bool) -> PathBuf {
+    let sdk = if simulator {
+        "appletvsimulator"
+    } else {
+        "appletvos"
+    };
+    let out = Command::new("xcrun")
+        .args(["--show-sdk-path", "--sdk", sdk])
+        .stderr(Stdio::inherit())
+        .output()
+        .expect("Failed to invoke xcrun")
+        .stdout;
+    PathBuf::from(String::from_utf8(out).expect("tvOS SDK path").trim())
+}
